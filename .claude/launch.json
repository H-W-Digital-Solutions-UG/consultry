{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "marketing-site",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "marketing-site",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "smoke-pages",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "smoketests/landingpage-positionierung",
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "marketing-site-astro",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--prefix",
        "marketing-site-astro",
        "astro",
        "dev",
        "--host",
        "127.0.0.1",
        "--port",
        "4322",
        "--root",
        "marketing-site-astro"
      ],
      "port": 4322
    }
  ]
}
