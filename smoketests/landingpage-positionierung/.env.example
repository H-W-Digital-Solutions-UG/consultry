# Where the waitlist form posts. Defaults to the marketing site's route; in `vite dev` a mock answers.
VITE_WAITLIST_ENDPOINT=/api/waitlist/signup
# Optional cookieless beacon target for page_view / cta_click / widget_interact / waitlist_submit.
# Leave unset to keep events in window.dataLayer only.
# VITE_TRACK_ENDPOINT=https://example.invalid/collect
