{
  "name": "consultry-marketing-astro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4321",
    "check": "astro check",
    "build": "astro build",
    "preview": "HOST=127.0.0.1 PORT=4321 node dist/server/entry.mjs",
    "test": "node --experimental-strip-types --test src/lib/waitlist/server.test.mjs src/content/offer-demo.test.mjs src/i18n/locale.test.mjs src/i18n/offer.test.mjs",
    "test:offer:mutations": "node scripts/check-offer-mutations.mjs",
    "check:output": "node scripts/check-output.mjs",
    "check:i18n": "node --experimental-strip-types scripts/check-i18n.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.5",
    "@astrojs/vercel": "^11.0.10",
    "astro": "^7.3.2",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@types/node": "^24.0.0",
    "@types/three": "^0.186.0",
    "typescript": "^5.9.0"
  }
}
