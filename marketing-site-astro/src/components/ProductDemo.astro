---
import { deliveryWorkflows } from '../content/demo-delivery-workflows';
import { ledgerWorkflows } from '../content/demo-ledger-workflows';
import { deliveryCanvases } from '../content/demo-delivery-canvas';
import { ledgerCanvases } from '../content/demo-ledger-canvas';
import { demoAgents, demoAgentVoices } from '../content/demo-agent-voices';
import type { DemoVariant } from '../content/demo-workflow-types';
import '../styles/product-demo.css';

interface Props { variant: DemoVariant; id?: string }
const { variant, id = `product-demo-${Astro.props.variant}` } = Astro.props;
const workflow = { ...deliveryWorkflows, ...ledgerWorkflows }[variant];
const canvas = { ...deliveryCanvases, ...ledgerCanvases }[variant];
const panels = workflow.steps;
const voices = demoAgentVoices[variant];
const stateLabel = { done: 'Berücksichtigt', open: 'Noch zu klären', blocked: 'Gesperrt' };
---
<section id={id} class="product-demo" data-product-demo data-variant={variant} data-demo-view="current" aria-label={`${workflow.title}: interaktives Produktbeispiel`}>
  <header class="pd-app-header">
    <div class="pd-project"><img src="/images/consultry-logo.png" width="20" height="20" alt="" /><span class="pd-crumb">Aufträge</span><span class="pd-app-divider" aria-hidden="true">›</span><strong>{workflow.title}</strong><span class="pd-draft"><i aria-hidden="true"></i>Beispiel</span></div>
    <span class="pd-example"><span class="pd-mono">{canvas.scope}</span></span>
  </header>
  <div class="pd-main">
    <aside class="pd-prompt-workspace" aria-label="Prompt Workspace">
      <details class="pd-prompt-details" open>
        <summary><span>Was soll ich übernehmen?</span><span class="pd-collapse-icon" aria-hidden="true">−</span></summary>
        <div class="pd-composer">
          <dl class="pd-context-row">
            <div><dt>Projekt</dt><dd>{canvas.scope}</dd></div>
            <div><dt>Rolle</dt><dd>{workflow.role}</dd></div>
          </dl>
          <details class="pd-task-brief">
            <summary><span class="pd-chip pd-chip--doc">{panels[0].sourceIds.length} {panels[0].sourceIds.length === 1 ? 'Unterlage' : 'Unterlagen'}</span><span class="pd-chip pd-chip--ai">{panels.length} Schritte</span><span class="pd-chip-more" aria-hidden="true">+</span></summary>
            <ul>{workflow.sources.filter(source => panels[0].sourceIds.includes(source.id)).map(source => <li><strong>{source.title}</strong><small>{source.meta.replace(/^(?:Illustratives Beispiel|Beispieldaten) · /, '')}</small><p>{source.excerpt}</p></li>)}</ul>
          </details>
          <div class="pd-prompt-field"><span class="pd-eyebrow">Prompt</span><h3>{canvas.prompt}</h3><p class="pd-scope">Beispielauftrag · keine automatische Übernahme</p></div>
          <div class="pd-composer-foot"><span class="pd-workspace-state"><i aria-hidden="true"></i>Interner Workspace</span><button class="pd-run" type="button" data-demo-run>Auftrag durchspielen<span aria-hidden="true">↗</span></button></div>
        </div>
      </details>
      <div class="pd-agent-panels">
        {panels.map((panel, index) => {
          const current = voices[index][voices[index].length - 1];
          const agent = demoAgents[current.agent];
          return <section class="pd-agent-panel" data-demo-agent-panel={index} data-active={index === 0} aria-hidden={index !== 0} inert={index !== 0} aria-label={`Agentenbeitrag: ${panel.label}`}>
            <div class="pd-agent-heading"><span class="pd-agent-avatar" data-tone={agent.tone} aria-hidden="true">{agent.initials}</span><div><strong>{agent.name}</strong><span>{agent.kind === 'system' ? 'system' : 'agent'} · {agent.role}</span></div></div>
            <p class="pd-agent-text">{current.text}</p>
            <p class="pd-agent-status"><span data-agent-status="reading">▸ liest Grundlage…</span><span data-agent-status="working">▸ bereitet Änderung vor…</span><span data-agent-status="result">✓ Beitrag im Canvas</span></p>
            <details class="pd-contributions"><summary>Weitere Beiträge <span aria-hidden="true">+</span></summary>{voices[index].slice(0, -1).map(contribution => <p><strong>{demoAgents[contribution.agent].name}</strong>{contribution.text}</p>)}</details>
          </section>;
        })}
      </div>
    </aside>
    <div class="pd-canvas pd-result">
      <span class="pd-viewport-target" data-demo-viewport aria-hidden="true"></span>
      <header class="pd-canvas-header"><div><span class="pd-canvas-label">Canvas</span><h3>{canvas.title}</h3></div><button type="button" class="pd-toggle" data-demo-toggle aria-label="Beispielablauf abspielen"><span aria-hidden="true" data-demo-toggle-icon>▶</span><span data-demo-toggle-label>Abspielen</span></button></header>
      <nav class="pd-navigation" aria-label="Arbeitsstand ansehen">
        <div class="pd-steps" role="group" aria-label="Schritt im Produktbeispiel" style={`--pd-step-count:${panels.length}`}>
          {panels.map((panel, index) => <button type="button" data-demo-step={index} data-step-id={panel.id} data-caption={panel.caption} data-duration={panel.duration} aria-pressed={index === 0} aria-controls={`${id}-panel-${index}`}><span class="pd-step-number">{String(index + 1).padStart(2, '0')}</span><span>{panel.label}</span><span class="pd-step-progress" aria-hidden="true"><i /></span></button>)}
        </div>
      </nav>
      <div class="pd-caption"><span class="pd-playback-status" data-demo-status>Arbeitsablauf</span><div class="pd-caption-copy"><p data-demo-caption>{panels[0].caption}</p>{panels.map(panel => <span class="pd-caption-measure" aria-hidden="true">{panel.caption}</span>)}</div></div>
      <article class="pd-artifact" data-kind={canvas.kind} aria-label={canvas.title}>
        <header class="pd-document-header"><span data-demo-version>{canvas.versions[0]}</span><div class="pd-view-control" role="group" aria-label="Arbeitsstände vergleichen"><button type="button" data-demo-view-button="basis" aria-pressed="false">Ausgangsstand</button><button type="button" data-demo-view-button="current" aria-pressed="true">Arbeitsstand</button></div></header>
        <div class="pd-panels">
          {panels.map((panel, index) => <section id={`${id}-panel-${index}`} class="pd-panel" data-demo-panel={index} data-active={index === 0} data-version={canvas.versions[index]} aria-hidden={index !== 0} inert={index !== 0} aria-label={panel.label}>
            <span class="pd-focus-target" data-demo-focus aria-hidden="true"></span>
            <div class="pd-workspace">
              <div class="pd-document-body">
                <div class="pd-document-title"><h4 tabindex="-1" data-demo-result-title>{panel.artifact.title}</h4><span class="pd-badge" data-tone={panel.artifact.tone}>{panel.artifact.status}</span></div>
                <div class="pd-document-blocks">
                  {panel.artifact.blocks.map((block, blockIndex) => <section class:list={['pd-document-section', {'pd-document-section--revision': !!block.before}]} data-canvas-focus={blockIndex === canvas.focusBlocks[index]}>
                    <h5><span class="pd-block-index" aria-hidden="true">{String(blockIndex + 1).padStart(2, '0')}</span>{block.label}</h5>
                    {block.before && <p class="pd-before"><span class="pd-sr-only">Bisher: </span><del>{block.before}</del></p>}
                    {block.text && <p class:list={['pd-document-text', {'pd-after': !!block.before}]}>{block.before && <span class="pd-sr-only">Überarbeitet: </span>}{block.text}</p>}
                    {block.items && <ul class="pd-work-items">{block.items.map(item => <li data-state={item.state}><span class="pd-sr-only">{stateLabel[item.state]}: </span><span class="pd-work-state" aria-hidden="true">{item.state === 'done' ? '✓' : item.state === 'blocked' ? '−' : '○'}</span><span>{item.text}</span></li>)}</ul>}
                  </section>)}
                </div>
              </div>
              <details class="pd-sources">
                <summary><span>{panel.sourceIds.length} {panel.sourceIds.length === 1 ? 'Quelle' : 'Quellen'} &amp; Herleitung</span><span aria-hidden="true">+</span></summary>
                <div class="pd-source-list">{workflow.sources.filter(source => panel.sourceIds.includes(source.id)).map(source => <details class="pd-source-file"><summary><span>{source.title}<small>{source.meta.replace(/^(?:Illustratives Beispiel|Beispieldaten) · /, '')}</small></span><span aria-hidden="true">+</span></summary><blockquote>{source.excerpt}</blockquote></details>)}</div>
              </details>
              <footer class="pd-review-bar"><p>{panel.note || panel.artifact.status}</p>{index < panels.length - 1 ? <button class="pd-action" type="button" data-demo-advance={index + 1}>Nächsten Stand ansehen<span aria-hidden="true">→</span></button> : <a class="pd-action" data-demo-download download={workflow.download.filename} href={`data:text/plain;charset=utf-8,${encodeURIComponent(workflow.download.text)}`}>{workflow.download.label}<span aria-hidden="true">↓</span></a>}</footer>
            </div>
          </section>)}
        </div>
      </article>
      <span class="pd-sr-only" data-demo-announcer aria-live="polite" aria-atomic="true"></span>
    </div>
  </div>
  <footer class="pd-footer"><span class="pd-mono">fiktiv · keine Kundendaten</span><a href="#waitlist-form">Mit eigenen Unterlagen erproben ↗</a><span data-demo-count>01 / {String(panels.length).padStart(2, '0')}</span></footer>
</section>
<script>
  import '../scripts/product-demo';
</script>
