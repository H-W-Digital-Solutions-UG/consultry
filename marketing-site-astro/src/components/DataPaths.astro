---
import UiIcon from "./UiIcon.astro";
import { localeFromPath, localizedPath } from '../i18n/locale';
import { useTranslations } from '../i18n/ui';
const locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);
const link = (path: string) => localizedPath(path, locale);
const paths = [
  { icon:'tenant', title:'Grundschutz für alle.', label:'Im Kern enthalten.', text:'Klare Befugnisse für Daten, Werkzeuge und Aktionen.' },
  { icon:'eu', title:'Bei Bedarf privater.', label:'Private Modelle als Option.', text:'Zusätzliche Isolation für besondere Anforderungen.' },
  { icon:'onprem', title:'Passend betrieben.', label:'Hosting als Option.', text:'Umgebung und Betrieb klären wir gemeinsam.' },
];
---
<section class="data-paths section" id="datenwege" aria-labelledby="data-paths-title">
  <div class="shell">
    <header class="data-paths-heading">
      <div>
        <h2 id="data-paths-title">{t("Gute KI.")}<br /><span>{t("Klare Grenzen.")}</span></h2>
      </div>
      <div class="data-paths-context">
        <p>{t("Nutze passende Modelle auf Datenwegen, die du verantworten kannst.")}</p>
        <a class="text-link" href={link("/produkt/zugriff")}>{t("Zugriff & Kontrolle entdecken")} <span aria-hidden="true"><UiIcon name="up-right" /></span></a>
      </div>
    </header>
    <div class="data-paths-routes">
      {paths.map(path => (
        <article class="data-paths-route">
          <div class="data-paths-route-top">
            <img src={`/hero/path-${path.icon}-160.webp`} alt="" width="64" height="64" loading="lazy" decoding="async" />
            <h3>{t(path.title)}</h3>
          </div>
          <p class="data-paths-description"><span>{t(path.label)}</span> {t(path.text)}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .data-paths { background: #f6f2ed; color: #151413; }
  .data-paths-heading { display: grid; grid-template-columns: 1.4fr 1fr; gap: clamp(2rem, 7vw, 7rem); align-items: end; }
  .data-paths h2 { font-size: clamp(2.75rem, 5.1vw, 4.6rem); line-height: 1.05; letter-spacing: -.055em; }
  .data-paths h2 span { color: inherit; }
  .data-paths-context { max-width: 25rem; padding-bottom: .2rem; }
  .data-paths-context > p { font-size: clamp(1.05rem, 1.65vw, 1.3rem); line-height: 1.55; color: #665d53; }
  .data-paths-context .text-link { margin-top: 1.4rem; color: #6b432e; font-size: .88rem; }
  .data-paths-routes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1.8rem, 4vw, 4rem); margin-top: clamp(2.5rem, 5vw, 4rem); }
  .data-paths-route { min-width: 0; padding-top: 1.3rem; border-top: 1px solid #d9cfc2; }
  .data-paths-route-top { display: flex; align-items: center; gap: .85rem; margin-bottom: 1rem; }
  .data-paths-route img { flex: none; width: 64px; height: 64px; object-fit: contain; }
  .data-paths-route h3 { margin: 0; font-size: clamp(1.35rem, 2vw, 1.8rem); line-height: 1.18; letter-spacing: -.035em; }
  .data-paths-description { max-width: 36ch; color: #70665d; font-size: 1rem; line-height: 1.65; }
  .data-paths-description span { color: #3d352e; }
  .data-paths :is(a):focus-visible { outline-color: #995534; }
  @media (max-width: 900px) {
    .data-paths-heading { grid-template-columns: 1fr; gap: 1.6rem; }
    .data-paths-context { max-width: 35rem; }
    .data-paths-route-top { flex-direction: column; align-items: flex-start; gap: .5rem; }
  }
  @media (max-width: 620px) {
    .data-paths h2 { font-size: clamp(2.3rem, 9.4vw, 3.4rem); }
    .data-paths-routes { grid-template-columns: 1fr; gap: 1.6rem; }
    .data-paths-route { padding-top: 1.1rem; }
    .data-paths-route-top { flex-direction: row; align-items: center; gap: .75rem; margin-bottom: .65rem; }
    .data-paths-route img { width: 52px; height: 52px; }
    .data-paths-route h3 { font-size: clamp(1.35rem, 5.6vw, 1.7rem); }
    .data-paths-description { max-width: 43ch; }
  }
</style>
