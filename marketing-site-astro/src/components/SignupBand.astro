---
import WaitlistForm from './WaitlistForm.astro';
import { FOR_WHOM_LINE } from '../content/shared';
interface Props { title?: string; text?: string; source?: string; heading?: 'h1' | 'h2' }
const { title = 'Die nächste Aufgabe beginnt auf gutem Stand.', text = 'Trag dich ein. Wir melden uns zur nächsten Erprobungsrunde.', source = Astro.url.pathname, heading: Heading = 'h2' } = Astro.props;
---
<section class="signup-section signup-chapter section" id="warteliste">
  <div class="shell">
    <header class="signup-chapter-heading">
      <div>
        <Heading class="signup-chapter-title">{title}</Heading>
      </div>
      <p class="signup-chapter-description">{text}</p>
    </header>
    <WaitlistForm source={source} id="waitlist-form" />
    <p class="signup-chapter-focus">{FOR_WHOM_LINE}</p>
  </div>
</section>

<style>
  .signup-chapter { background: #151413; border-top: 0; }
  .signup-chapter-heading { display: grid; grid-template-columns: 1.55fr .7fr; gap: 3rem; align-items: end; margin-bottom: 3rem; }
  .signup-chapter-title { max-width: 19ch; font-size: clamp(2.7rem, 5.4vw, 5rem); line-height: 1.035; letter-spacing: -.06em; color: #f6f2ed; }
  .signup-chapter-description { max-width: 26ch; padding-bottom: .3rem; color: #bcafa3; font-size: clamp(.95rem, 1.6vw, 1.2rem); line-height: 1.6; }
  .signup-chapter-focus { max-width: 85ch; padding-top: 1.5rem; color: #b3a397; font-size: .78rem; line-height: 1.7; }
  @media (max-width: 900px) {
    .signup-chapter-heading { grid-template-columns: 1fr; gap: 1.4rem; }
    .signup-chapter-title { max-width: 21ch; }
    .signup-chapter-description { max-width: 45ch; }
  }
  @media (max-width: 620px) {
    .signup-chapter-heading { margin-bottom: 2rem; }
    .signup-chapter-title { font-size: clamp(2.2rem, 9.2vw, 3.5rem); }
  }
</style>
