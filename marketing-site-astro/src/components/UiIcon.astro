---
/** Decorative interface icons, rendered as vectors to avoid OS emoji fonts. */
interface Props {
  name: 'up-right' | 'right' | 'left' | 'down' | 'chevron-right' | 'play' | 'pause' | 'replay';
}
const { name } = Astro.props;
const paths: Record<Props['name'], string> = {
  'up-right': 'M6 18 18 6M6 6h12v12',
  right: 'M4 12h16M13 5l7 7-7 7',
  left: 'M20 12H4M11 5l-7 7 7 7',
  down: 'M12 4v16M5 13l7 7 7-7',
  'chevron-right': 'm9 5 7 7-7 7',
  play: 'm8 5 11 7-11 7Z',
  pause: 'M8 5v14M16 5v14',
  replay: 'M3 10a9 9 0 1 1 1 7M3 4v6h6',
};
---
<svg class="ui-icon" data-ui-icon={name} xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d={paths[name]} /></svg>
<style>
  .ui-icon { display: inline-block; flex-shrink: 0; vertical-align: middle; }
</style>
