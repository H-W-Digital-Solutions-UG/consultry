---
import HeroScene from './HeroScene.astro';
import HeroSignals from './HeroSignals.astro';
import HeroConversion from './HeroConversion.astro';
import type { HeroOutcomeVariant } from '../content/hero-outcomes';
import type { SceneVariant } from '../lib/scene/variants';
interface Props {
  variant: HeroOutcomeVariant;
  /** Homepage mark can differ from the product example explained beside it. */
  sceneVariant?: SceneVariant;
  title: string;
  titleEnd: string;
  lede: string;
  aspects: string[];
  productLabel?: string;
}
const { variant, sceneVariant = variant, title, titleEnd, lede, aspects, productLabel } = Astro.props;
const home = !productLabel;
---
<section class:list={['shell', home ? 'home-hero' : 'landing-hero']} data-immersive="true" data-scroll-scene data-scene-kind={variant} data-scene-aspect="0">
  {!home && <a class="breadcrumb" href="/produkt"><span aria-hidden="true">←</span> {productLabel}</a>}
  <div class={home ? 'home-story' : 'landing-story'}>
    <header class="hero-copy"><h1>{title.trim()}{' '}<span>{titleEnd}</span></h1><p class="hero-mobile-lede">{lede}</p></header>
    <div class="hero-stage hero-stage--connected">
      <div class="hero-object-track" data-scene-focus-track>
        <div class="hero-pin" data-scene-focus>
        <div class="hero-object" data-scene-focus>
          <p class="hero-intro">{lede}</p>
          <div class="hero-art"><HeroScene variant={sceneVariant} annotated /></div>
          <HeroSignals variant={variant} aspects={aspects} />
        </div>
        <HeroConversion home={home} variant={variant} />
        </div>
      </div>
    </div>
  </div>
</section>
