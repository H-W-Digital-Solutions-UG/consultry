---
import UiIcon from "./UiIcon.astro";
import { waitlistConsent, waitlistConsentVersion } from '../lib/waitlist/consent';
import { localeFromPath, localizedPath } from '../i18n/locale';
import { useTranslations } from '../i18n/ui';
const locale = localeFromPath(Astro.url.pathname);
const consent = waitlistConsent[locale];
const t = useTranslations(locale);
const link = (path: string) => localizedPath(path, locale);
interface Props {
  source: string;
  id?: string;
  title?: string;
  description?: string;
}
const {
  source,
  id = "warteliste",
  title = "Deine Arbeit. Unser nächster Praxistest.",
  description = "Verpasse nicht den Early-Access-Rabatt. Consultry ist noch in Entwicklung. Trag dich für die Erprobung ein.",
} = Astro.props;
---

<form id={id} class="waitlist-form" data-waitlist-form data-source={source} data-locale={locale} data-consent-version={waitlistConsentVersion} aria-labelledby={`${id}-title`}>
  <div class="waitlist-content" data-form-content>
    <div class="waitlist-introduction">
      <h2 id={`${id}-title`}>{t(title)}</h2>
      <p class="waitlist-description">{t(description)}</p>
    </div>
    <div class="waitlist-fields">
    <label class="waitlist-email-label" for={`${id}-email`}>{t("Geschäftliche E-Mail")}</label>
    <input id={`${id}-email`} name="email" type="email" autocomplete="email" inputmode="email" placeholder={t("du@unternehmen.de")} maxlength="254" required aria-describedby={`${id}-status`} />
    <div class="waitlist-honeypot" aria-hidden="true" inert>
      <label for={`${id}-website`}>{t("Website")}</label>
      <input id={`${id}-website`} name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>
    <label class="waitlist-consent">
      <input name="newsletterConsent" type="checkbox" required />
      <span>{consent.communications} {consent.processing} {consent.privacyPrefix} <a href={link("/legal/datenschutz")}>{consent.privacyLabel}</a>{consent.withdrawal}</span>
    </label>
    <button type="submit" disabled data-submit>{t("Für den Pilot vormerken")} <span aria-hidden="true"><UiIcon name="up-right" /></span></button>
    </div>
  </div>
  <p id={`${id}-status`} class="waitlist-status" role="status" aria-live="polite" data-form-status>{t("Warteliste wird geprüft …")}</p>
  <noscript><p>{t("Bitte aktiviere JavaScript, um die Verfügbarkeit der Warteliste zu prüfen und dich einzutragen.")}</p></noscript>
</form>

<script>
  import "../scripts/waitlist";
</script>

<style>
  .waitlist-form { position: relative; width: 100%; max-width: none; padding: clamp(1.4rem, 4.2vw, 3.5rem); border: 0; border-top: 3px solid #bd795c; border-radius: 0; background: #f3efe7; color: #171513; color-scheme: light; scroll-margin-top: 0; }
  .waitlist-content { display: grid; grid-template-columns: 1fr 1.5fr; gap: clamp(2rem, 5vw, 5rem); }
  .waitlist-content[hidden] { display: none; }
  .waitlist-introduction, .waitlist-fields { min-width: 0; }
  h2 { max-width: 14ch; margin: 0; font-size: clamp(1.8rem, 3vw, 2.6rem); line-height: 1.08; letter-spacing: -.055em; }
  .waitlist-description { max-width: 33ch; margin: 1rem 0 0; color: #675c51; font-size: .94rem; line-height: 1.6; }
  .waitlist-email-label { display: block; margin-bottom: .7rem; font-size: .88rem; font-weight: 500; }
  input[type="email"] { box-sizing: border-box; width: 100%; min-height: 3.5rem; border: 1px solid #cbbdad; border-radius: .2rem; background: #fffdf8; padding: 1rem; font: inherit; font-size: 1rem; color: #29251f; }
  .waitlist-consent { display: flex; align-items: flex-start; gap: .75rem; margin: 1.15rem 0 1.5rem; font-size: .82rem; line-height: 1.65; color: #716558; cursor: pointer; }
  .waitlist-consent input { width: 1.15rem; height: 1.15rem; margin: .15rem 0 0; accent-color: #855338; flex: 0 0 auto; }
  a { color: #59432f; text-decoration: underline; text-underline-offset: .2em; }
  button { display: flex; width: 100%; min-height: 3.5rem; align-items: center; justify-content: space-between; gap: 1rem; padding: 1rem 1.25rem; border: 1px solid #282019; border-radius: .2rem; background: #282019; color: #fff8ef; font: inherit; font-size: .93rem; font-weight: 500; text-align: left; cursor: pointer; }
  button span { font-size: 1.4rem; line-height: 1; }
  button:disabled { background: #d1c3b4; border-color: #d1c3b4; color: #695b4e; cursor: not-allowed; }
  button:not(:disabled):hover { background: #574131; }
  :is(input, button, a):focus-visible { outline: 2px solid #995534; outline-offset: 4px; }
  input[aria-invalid="true"] { border-color: #9b3d2f; }
  .waitlist-status { margin: 1.5rem 0 0; padding-top: 1rem; border-top: 1px solid #d9ccbe; font-size: .86rem; line-height: 1.6; color: #776350; }
  .waitlist-status:empty { display: none; }
  .waitlist-status[data-state="error"] { color: #963c2b; }
  .waitlist-status[data-state="success"] { margin: 0; padding: 1rem; border: 0; border-radius: .2rem; background: #e7eee3; color: #344c31; }
  .waitlist-honeypot { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  @media (max-width: 700px) {
    .waitlist-content { grid-template-columns: 1fr; gap: 1.8rem; }
    .waitlist-kicker { margin-bottom: .8rem; }
    h2 { max-width: 19ch; }
    .waitlist-description { max-width: 41ch; }
    .waitlist-consent { font-size: .78rem; }
  }
</style>
