---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SpatialHero from '../../components/SpatialHero.astro';
import ProductDemo from '../../components/ProductDemo.astro';
import DataPaths from '../../components/DataPaths.astro';
import SignupBand from '../../components/SignupBand.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { products } from '../../content/products';
export function getStaticPaths() { return products.map(product => ({ params:{slug:product.slug}, props:{product} })); }
const { product } = Astro.props;
const c = product.content;
const titleAccents: Record<string, string> = { brain: 'arbeitet mit.', corpus: 'an nutzbar.', brand: 'Eure Freigaben.', ledger: 'Ein gemeinsamer Stand.', access: 'wie für Menschen.' };
const accent = titleAccents[c.variant];
const titleStart = c.hero.title.slice(0, -accent.length);
---
<BaseLayout title={c.meta.title} description={c.meta.description} minimal>
  <main id="inhalt">
    <SpatialHero variant={c.variant} title={titleStart} titleEnd={accent} lede={c.hero.lede} aspects={product.aspects} productLabel={product.label} />
    <section class="section demo-section landing-demo" id="produktflaeche"><div class="shell"><SectionHeading description={c.how.lede ?? 'Ein Beispiel zum Durchspielen.'}>{c.how.title}</SectionHeading><ProductDemo variant={c.variant} /><div class="demo-next-step"><p>Was wäre mit eurem Wissen möglich?</p><a class="text-link" href="#waitlist-form">Gemeinsam erproben <span aria-hidden="true">↗</span></a></div></div></section>
    <section class="section context-section"><div class="shell"><div class="context-layout"><div data-reveal><h2>{c.problem.title}</h2><p class="section-copy">{c.problem.lede}</p></div><div class="boundaries"><h3>Was ihr erwarten könnt.</h3>{c.boundaries.items.map((item) => <details><summary>{item.claim}</summary><p>{item.limit}</p></details>)}</div></div></div></section>
    <DataPaths />
    <SignupBand title={c.band.title} text={c.band.text} source={`/produkt/${product.slug}`} />
  </main>
</BaseLayout>
