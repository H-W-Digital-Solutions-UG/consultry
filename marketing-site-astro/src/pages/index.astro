---
import BaseLayout from '../layouts/BaseLayout.astro';
import SpatialHero from '../components/SpatialHero.astro';
import ProductGallery from '../components/ProductGallery.astro';
import ProductDemo from '../components/ProductDemo.astro';
import DataPaths from '../components/DataPaths.astro';
import SignupBand from '../components/SignupBand.astro';
import SectionHeading from '../components/SectionHeading.astro';
import DemoTaskPicker from '../components/DemoTaskPicker.astro';
---
<BaseLayout title="Consultry · Firmenwissen, das weiterarbeitet">
  <main id="inhalt">
    <SpatialHero variant="corpus" sceneVariant="logo" title="Euer Wissen." titleEnd="Arbeitet weiter." lede="Ein Arbeitskern für euer Team und KI-Agenten." aspects={['Ein Vertrag reicht zum Start.', 'Erfahrung wird Vorschlag.', 'Lücken bleiben sichtbar.']} />
    <section class="section demo-section" id="arbeitsbeispiel">
      <div class="shell">
        <SectionHeading description="Aus Vertrag und Vorarbeit wird ein Gesprächsbriefing.">Die nächste Aufgabe.<br /><span>Mit eurer Vorarbeit.</span></SectionHeading>
        <DemoTaskPicker />
        <ProductDemo variant="corpus" />
        <a class="text-link demo-deep-link" href="/produkt/korpus">Den Korpus entdecken <span aria-hidden="true">↗</span></a>
      </div>
    </section>
    <section class="section product-section" id="produkt">
      <div class="shell">
        <ProductGallery scrollDriven nextHref="#datenwege" nextLabel="Weiter zu den Datenwegen">
          <SectionHeading slot="intro" description="Der Einstieg, der zu eurer Arbeit passt.">Ein Arbeitskern.<br /><span>Viele Möglichkeiten.</span></SectionHeading>
        </ProductGallery>
        <div class="gallery-footer"><a class="text-link" href="/produkt">Alle Produktbereiche <span aria-hidden="true">↗</span></a></div>
      </div>
    </section>
    <DataPaths />
    <SignupBand />
  </main>
</BaseLayout>
