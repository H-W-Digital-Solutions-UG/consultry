---
import UiIcon from "../components/UiIcon.astro";
import { localeFromPath, localizedPath } from '../i18n/locale';
import { useTranslations } from '../i18n/ui';
const locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);
const link = (path: string) => localizedPath(path, locale);
import BaseLayout from '../layouts/BaseLayout.astro';
import SignupBand from '../components/SignupBand.astro';
---
<BaseLayout title={t("Über Consultry")}><main id="inhalt"><section class="section shell prose-page"><h1>{t("Deine Arbeit geht weiter.")}<br /><span>{t("Dein Wissen kommt mit.")}</span></h1><p class="hero-lede">{t("KI soll dir Arbeit abnehmen. Nicht neue Briefings, Korrekturen und Abstimmungsrunden bescheren. Dafür entwickeln wir Consultry.")}</p><div class="prose-grid"><h2>{t("Mit dem beginnen,")}<br />{t("was schon da ist.")}</h2><div><p>{t("Du hast recherchiert, entschieden, verworfen und verbessert. Darin steckt Arbeit, die für die nächste Aufgabe wertvoll ist. Consultry soll sie mit ihren Grundlagen verbinden und für Menschen und Agenten nutzbar machen. Ob du allein gründest, im kleinen Team arbeitest oder Teil einer großen Organisation bist.")}</p><p>{t("Beratungsqualität ist unser Maßstab: fundierte, konsistente und verwendbare Arbeit. IT- und SAP-Beratungen in DACH sind ein wichtiger Ausgangspunkt für die Erprobung. Consultry befindet sich vor dem Produktstart.")}</p><a class="text-link" href={link("/produkt")}>{t("Die Arbeitsweise entdecken")} <span aria-hidden="true"><UiIcon name="up-right" /></span></a></div></div></section><SignupBand /></main></BaseLayout>
