---
import { localeFromPath, localizedPath } from '../../i18n/locale';
import { useTranslations } from '../../i18n/ui';
const locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);
const link = (path: string) => localizedPath(path, locale);
import BaseLayout from "../../layouts/BaseLayout.astro";
import { legalDocuments, type LegalDocument } from "../../content/legal";
import { englishLegal } from '../../i18n/legal';

export const prerender = true;
export function getStaticPaths() {
  return legalDocuments.map((document) => ({ params: { slug: document.slug }, props: { document } }));
}
interface Props { document: LegalDocument; }
const document = locale === 'en' ? { ...Astro.props.document, ...englishLegal[Astro.props.document.slug] } : Astro.props.document;
---

<BaseLayout title={document.title} description={document.description} path={`/legal/${document.slug}`}>
  <main class="legal-copy" id="inhalt">
    <nav aria-label={t("Rechtliche Dokumente")}>
      <a href={link("/")}>{t("Consultry")}</a>
      {legalDocuments.map((item) => <a href={link(`/legal/${item.slug}`)} aria-current={item.slug === document.slug ? "page" : undefined}>{t(item.slug === "agb" ? "AGB" : item.slug === "datenschutz" ? "Datenschutz" : item.title)}</a>)}
    </nav>
    <header>
      <p>{t("Rechtliches")}</p>
      <h1>{document.title}</h1>
      {document.metaItems.length > 0 && <dl>{document.metaItems.map((item) => <div><dt>{item.label}</dt><dd>{item.value}</dd></div>)}</dl>}
      {document.intro && <div set:html={document.intro} />}
    </header>
    {document.sections.map((section) => <section><h2>{section.title}</h2><div set:html={section.html} /></section>)}
    <p>{t("Stand:")} {document.lastUpdated}</p>
  </main>
</BaseLayout>
