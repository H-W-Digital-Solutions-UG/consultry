---
import UiIcon from "../components/UiIcon.astro";
import { localeFromPath, localizedPath } from '../i18n/locale';
import { useTranslations } from '../i18n/ui';
const locale = localeFromPath(Astro.url.pathname);
const t = useTranslations(locale);
const link = (path: string) => localizedPath(path, locale);
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title={t("Seite nicht gefunden")}><main id="inhalt" class="section shell prose-page"><h1>{t("Hier geht es")}<br /><span>{t("nicht weiter.")}</span></h1><p class="hero-lede">{t("Die Seite wurde nicht gefunden.")}</p><a class="button" href={link("/produkt")}>{t("Produkt entdecken")} <span aria-hidden="true"><UiIcon name="up-right" /></span></a></main></BaseLayout>
