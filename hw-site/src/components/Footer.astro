---
import { company, nav } from "../data/company";
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <p class="footer__name">{company.name}</p>
      <p class="footer__claim">{company.claim}</p>
    </div>
    <div>
      <p class="footer__head">Navigation</p>
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </div>
    <div>
      <p class="footer__head">Kontakt</p>
      <ul>
        <li><a href={`mailto:${company.email}`}>{company.email}</a></li>
        <li><a href={company.phoneHref}>{company.phoneDisplay}</a></li>
        <li>{company.address.street}, {company.address.postalCode} {company.address.city}</li>
      </ul>
    </div>
    <div>
      <p class="footer__head">Rechtliches</p>
      <ul>
        <li><a href="/impressum">Impressum</a></li>
        <li><a href="/datenschutz">Datenschutz</a></li>
      </ul>
    </div>
  </div>
  <div class="container footer__bottom">
    <span>© {year} {company.legalName}</span>
    <span>{company.address.city}</span>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink);
    color: var(--fg-on-ink-muted);
    border-top: 1px solid var(--line-on-ink);
    font-size: 0.92rem;
  }
  .footer__grid {
    display: grid;
    gap: 36px;
    padding-block: 64px 40px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 720px) {
    .footer__grid { grid-template-columns: 1.6fr 1fr 1.2fr 1fr; }
  }
  .footer__name {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--fg-on-ink);
    letter-spacing: -0.02em;
  }
  .footer__claim { margin-top: 6px; }
  .footer__head {
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: -0.005em;
    color: var(--accent-on-ink);
    margin-bottom: 14px;
  }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  a:hover { color: var(--fg-on-ink); }
  .footer__bottom {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding-block: 20px 28px;
    border-top: 1px solid var(--line-on-ink);
    font-size: 0.8rem;
  }
</style>
