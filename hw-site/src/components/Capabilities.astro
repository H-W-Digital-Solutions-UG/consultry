---
import { capabilities } from "../data/content";
---

<ul class="caps">
  {capabilities.map((c) => (
    <li class="cap">
      <h3>{c.title}</h3>
      <p>{c.text}</p>
    </li>
  ))}
</ul>

<style>
  .caps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  }
  .cap {
    padding: 22px 22px 24px;
    border-radius: var(--radius-lg);
    background: var(--paper);
    border: 1px solid var(--line);
    display: grid;
    gap: 8px;
    align-content: start;
    transition: border-color 0.2s, transform 0.25s var(--ease-out);
  }
  .cap:hover { border-color: rgba(15, 18, 22, 0.28); transform: translateY(-2px); }
  .cap h3 { font-size: 1.02rem; }
  .cap p { color: var(--fg-muted); font-size: 0.93rem; }
</style>
