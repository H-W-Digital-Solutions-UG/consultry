---
/**
 * Minimalistische Visualisierung je Einwand (Startseite, „Unser Versprechen“).
 * Monoline-SVG in Markenlila auf hellem Grund, ohne Füllflächen und Glow.
 * Pfade tragen pathLength="1" und zeichnen sich mit `.is-in` ein (Desktop).
 *
 * Jede Abbildung folgt wörtlich dem Hook rechts daneben:
 *  align:      „Jeder fragt die AI anders, keiner weiß, ob es stimmt“ → Einzelne fragen
 *              in alle Richtungen, Ergebnis offen (?) | ein Ablauf, Ergebnis geprüft (✓)
 *  handover:   „Wir bringen beides mit, Ihr Team lernt es von uns“ → unser Anteil sinkt,
 *              der des Teams steigt, die Übergabe ist markiert
 *  rank:       „Wir rechnen es vorher durch, dann entscheiden Sie“ → Nutzen je Ablauf
 *              gegen die Kostenlinie, oberhalb rechnet es sich
 *  pilot:      „Wir bauen es in die Systeme, mit denen Ihr Team täglich arbeitet“ →
 *              der Pilot endet, die Lösung läuft in ein Fenster Ihres Systems
 */
interface Props { kind: "align" | "handover" | "rank" | "pilot" }
const { kind } = Astro.props;
/** Einzelne, jede Anfrage in eine andere Richtung: [x, y, dx, dy] */
const asks = [
  [28, 34, 13, -6], [62, 70, -4, 13], [42, 100, 14, 3], [96, 40, 6, -13],
  [84, 90, -12, 8], [108, 68, 11, -8],
];
const bars = [96, 82, 70, 52, 40, 30];
---

<svg class={`viz viz--${kind}`} viewBox="0 0 360 120" width="360" height="120" role="img" aria-hidden="true" focusable="false">
  {kind === "align" && (
    <g>
      {asks.map(([x, y, dx, dy]) => (
        <g>
          <circle class="dot dot--soft" cx={x} cy={y} r="4" />
          <path class="mk" d={`M${x} ${y} l${dx} ${dy}`} />
        </g>
      ))}
      <circle class="ring" cx="140" cy="62" r="9" />
      <text class="glyph" x="140" y="66" text-anchor="middle">?</text>
      <text class="lbl" x="84" y="118" text-anchor="middle">Jeder fragt anders, Ergebnis offen</text>
      <path class="ln draw" d="M158 62 H192 M184 56 l8 6 -8 6" pathLength="1" />
      <path class="ln draw" d="M208 62 H322" pathLength="1" />
      {[214, 234, 254, 274, 294, 314].map((x) => <circle class="dot" cx={x} cy="62" r="4" />)}
      <circle class="ring ring--on" cx="338" cy="62" r="9" />
      <path class="ln draw" d="M333.5 62 l3.5 3.5 l7 -7" pathLength="1" />
      <text class="lbl lbl--strong" x="272" y="118" text-anchor="middle">Ein Ablauf, Ergebnis geprüft</text>
    </g>
  )}
  {kind === "handover" && (
    <g>
      <path class="ax" d="M30 100 H340 M30 100 V16" />
      <path class="ln ln--soft draw" d="M30 22 C130 22 200 94 340 94" pathLength="1" />
      <path class="ln draw" d="M30 94 C130 94 200 22 340 22" pathLength="1" />
      <circle class="ring" cx="170" cy="58" r="5" />
      <circle class="dot" cx="340" cy="22" r="4" />
      <text class="lbl" x="38" y="14">Wir übernehmen</text>
      <text class="lbl lbl--strong" x="340" y="14" text-anchor="end">Ihr Team übernimmt</text>
      <text class="lbl" x="170" y="88" text-anchor="middle">Übergabe</text>
      <text class="lbl" x="340" y="114" text-anchor="end">Zeit</text>
    </g>
  )}
  {kind === "rank" && (
    <g>
      <path class="ax" d="M30 104 H340" />
      {bars.map((h, i) => (
        <rect class={i < 3 ? "bar bar--on" : "bar"} x={72 + i * 42} y={104 - h} width="22" height={h} rx="2" />
      ))}
      <path class="th draw" d="M30 46 H340" pathLength="1" />
      <text class="lbl" x="30" y="41">Kosten</text>
      <text class="lbl lbl--strong" x="340" y="41" text-anchor="end">rechnet sich</text>
      <text class="lbl" x="340" y="60" text-anchor="end">rechnet sich nicht</text>
      <text class="lbl" x="30" y="118">Nutzen je Ablauf, vorher gerechnet</text>
    </g>
  )}
  {kind === "pilot" && (
    <g>
      <path class="ln ln--soft draw" d="M30 90 C80 88 110 70 150 62" pathLength="1" />
      <path class="ln ln--dash" d="M150 62 C165 58 176 56 190 54" />
      <circle class="ring" cx="150" cy="62" r="4.5" />
      <text class="lbl" x="150" y="46" text-anchor="middle">Pilot, endet hier</text>
      <path class="ln draw" d="M30 90 C110 92 160 96 232 82 S290 73 298 73" pathLength="1" />
      <rect class="box draw" x="248" y="34" width="92" height="64" rx="8" pathLength="1" />
      <path class="grid" d="M248 47 H340 M262 60 H326 M262 73 H326 M262 86 H310" />
      {[256, 262, 268].map((x) => <circle class="mk-dot" cx={x} cy="40.5" r="1.5" />)}
      <circle class="dot" cx="298" cy="73" r="4" />
      <text class="lbl lbl--strong" x="340" y="114" text-anchor="end">In Ihren Systemen, täglich</text>
    </g>
  )}
</svg>

<style>
  .viz { display: block; width: 100%; height: auto; max-width: 380px; overflow: visible; }
  .ln { fill: none; stroke: var(--accent); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .ln--soft { stroke: var(--fg-muted); opacity: 0.55; }
  .ln--dash { stroke: var(--fg-muted); opacity: 0.45; stroke-dasharray: 3 4; }
  .ax { fill: none; stroke: var(--line-strong); stroke-width: 1; }
  .grid { fill: none; stroke: var(--line-strong); stroke-width: 1; }
  .th { fill: none; stroke: var(--accent); stroke-width: 1.2; stroke-dasharray: 4 4; }
  .dot { fill: var(--accent); }
  .dot--soft { fill: var(--fg-muted); opacity: 0.5; }
  .mk { fill: none; stroke: var(--fg-muted); stroke-width: 1.2; stroke-linecap: round; opacity: 0.6; }
  .mk-dot { fill: var(--line-strong); }
  .ring { fill: var(--paper); stroke: var(--fg-muted); stroke-width: 1.5; }
  .ring--on { stroke: var(--accent); }
  .box { fill: none; stroke: var(--accent); stroke-width: 1.5; }
  .bar { fill: none; stroke: var(--line-strong); stroke-width: 1; }
  .bar--on { fill: var(--accent); stroke: none; }
  .lbl { font-family: var(--font-body); font-weight: 500; font-size: 9px; letter-spacing: 0.04em; fill: var(--fg-muted); }
  .lbl--strong { fill: var(--accent); }
  .glyph { font-family: var(--font-body); font-weight: 600; font-size: 11px; fill: var(--fg-muted); }

  /* Einzeichnen in der Desktop-Szene: Pfade wachsen, Punkte und Flächen blenden nach. */
  :global(.promise[data-scene="on"]) .draw { stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 1.1s var(--ease-out) 0.35s; }
  :global(.promise[data-scene="on"] .promise__row.is-in) .draw { stroke-dashoffset: 0; }
  :global(.promise[data-scene="on"]) :is(.dot, .dot--soft, .mk, .mk-dot, .ring, .bar, .lbl, .glyph, .ax, .grid, .ln--dash) { opacity: 0; transition: opacity 0.6s var(--ease-out) 0.9s; }
  :global(.promise[data-scene="on"] .promise__row.is-in) :is(.dot, .mk-dot, .ring, .bar, .lbl, .glyph, .ax, .grid) { opacity: 1; }
  :global(.promise[data-scene="on"] .promise__row.is-in) .dot--soft { opacity: 0.5; }
  :global(.promise[data-scene="on"] .promise__row.is-in) .mk { opacity: 0.6; }
  :global(.promise[data-scene="on"] .promise__row.is-in) .ln--dash { opacity: 0.45; }
</style>
