---
import { company, nav } from "../data/company";
import Brand from "./Brand.astro";
const current = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header class="nav" data-nav>
  <div class="container nav__inner">
    <a href="/" class="nav__brand" aria-label={`Consultry, powered by ${company.name} – Startseite`}>
      <Brand size={30} />
    </a>

    <nav class="nav__links" id="site-nav" aria-label="Hauptnavigation">
      {nav.map((item) => (
        <a href={item.href} aria-current={current === item.href ? "page" : undefined}>{item.label}</a>
      ))}
      <a href="/kontakt" class="btn btn--on-ink nav__cta">Erstgespräch</a>
    </nav>

    <button class="nav__toggle" type="button" aria-controls="site-nav" aria-expanded="false" data-nav-toggle>
      <span class="sr-only">Menü</span>
      <span class="nav__bar" aria-hidden="true"></span>
      <span class="nav__bar" aria-hidden="true"></span>
    </button>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-nav]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  if (header) {
    // Über hellen Sektionen braucht die Nav einen soliden Balken: ab 24px Scroll
    let ticking = false;
    const setScrolled = () => { ticking = false; header.toggleAttribute("data-scrolled", window.scrollY > 24); };
    window.addEventListener("scroll", () => { if (!ticking) { ticking = true; requestAnimationFrame(setScrolled); } }, { passive: true });
    setScrolled();
  }
  if (header && toggle) {
    toggle.addEventListener("click", () => {
      const open = header.toggleAttribute("data-open");
      toggle.setAttribute("aria-expanded", String(open));
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && header.hasAttribute("data-open")) {
        header.removeAttribute("data-open");
        toggle.setAttribute("aria-expanded", "false");
        toggle.focus();
      }
    });
  }
</script>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    color: var(--fg-on-ink);
    background: linear-gradient(to bottom, rgba(21, 4, 43, 0.85), rgba(21, 4, 43, 0));
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }
  .nav {
    transition: background-color 0.25s var(--ease-out), box-shadow 0.25s var(--ease-out);
  }
  .nav[data-scrolled] {
    background: rgba(21, 4, 43, 0.92);
    box-shadow: inset 0 -1px 0 var(--line-on-ink);
  }
  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 18px;
  }
  .nav__brand {
    display: inline-flex;
    align-items: center;
    color: var(--fg-on-ink);
  }
  @media (max-width: 599px) {
    .nav__brand :global(.brand__logo) { height: 24px; width: auto; }
  }
  .nav__links {
    display: none;
    align-items: center;
    gap: 28px;
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: -0.005em;
  }
  .nav__links a:not(.btn) {
    color: var(--fg-on-ink-muted);
    transition: color 0.2s;
  }
  .nav__links a:not(.btn):hover,
  .nav__links a[aria-current="page"] {
    color: var(--fg-on-ink);
  }
  .nav__cta {
    padding: 11px 16px;
    font-size: 0.85rem;
  }
  .nav__toggle {
    display: inline-flex;
    flex-direction: column;
    gap: 5px;
    padding: 10px;
    background: transparent;
    border: 0;
    cursor: pointer;
  }
  .nav__bar {
    width: 22px;
    height: 2px;
    background: currentColor;
    transition: transform 0.25s var(--ease-out);
  }
  .nav[data-open] .nav__bar:first-of-type { transform: translateY(3.5px) rotate(45deg); }
  .nav[data-open] .nav__bar:last-of-type { transform: translateY(-3.5px) rotate(-45deg); }
  .nav[data-open] {
    background: var(--ink);
  }
  .nav[data-open] .nav__links {
    display: flex;
    position: absolute;
    inset: 100% 0 auto 0;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
    padding: 24px var(--gutter) 32px;
    background: var(--ink);
    border-top: 1px solid var(--line-on-ink);
    font-size: 1.05rem;
  }
  @media (min-width: 860px) {
    .nav__links { display: flex; }
    .nav__toggle { display: none; }
  }
</style>
