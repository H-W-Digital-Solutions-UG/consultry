---
import { hero } from "../data/content";
interface Props { image?: string; imageAlt?: string; }
const { image = "/images/hero.webp", imageAlt = "" } = Astro.props;
---

<section class="hero section--ink">
  <img class="hero__bg" src={image} alt={imageAlt} width="2560" height="1434" fetchpriority="high" decoding="async" />
  <div class="hero__shade" aria-hidden="true"></div>

  <div class="container hero__content">
    <p class="eyebrow reveal" style="--delay: .1s">{hero.eyebrow}</p>
    <h1 class="reveal" style="--delay: .25s">{hero.headline}</h1>
    <p class="hero__claim reveal" style="--delay: .4s">{hero.claim}</p>
    <p class="hero__desc reveal" style="--delay: .55s">{hero.description}</p>
    <div class="hero__actions reveal" style="--delay: .7s">
      <a class="btn btn--primary" href={hero.primaryCta.href}>
        {hero.primaryCta.label}
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
      </a>
      <a class="btn btn--ghost" href={hero.secondaryCta.href}>{hero.secondaryCta.label}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: var(--ink);
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% center;
    opacity: 0.9;
  }
  .hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgba(10, 12, 16, 0.95) 0%, rgba(10, 12, 16, 0.55) 45%, rgba(10, 12, 16, 0.15) 100%),
      linear-gradient(to right, rgba(10, 12, 16, 0.75) 0%, rgba(10, 12, 16, 0) 60%);
  }
  .hero__content {
    position: relative;
    z-index: 1;
    padding-block: 140px clamp(48px, 8vw, 96px);
    max-width: 880px;
    margin-inline: var(--gutter);
    width: auto;
  }
  @media (min-width: 1296px) {
    .hero__content { margin-inline: auto; width: min(100% - 2 * var(--gutter), var(--container)); max-width: none; }
    .hero__content > * { max-width: 880px; }
  }
  .hero h1 { margin-top: 18px; color: var(--fg-on-ink); }
  .hero__claim {
    margin-top: 16px;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2.2vw, 1.7rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    background: var(--axis);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    width: fit-content;
  }
  .hero__desc {
    margin-top: 20px;
    max-width: 60ch;
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    color: var(--fg-on-ink-muted);
    text-wrap: pretty;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }
</style>
