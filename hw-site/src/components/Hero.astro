---
/**
 * Hero der Startseite – „From Process to Production“.
 *
 * Aufbau: Der Bildlayer (.hero__visual) ist sticky und 100svh hoch, die Copy
 * liegt per negativem Margin über dem ersten Viewport und scrollt ganz normal
 * mit der Seite nach oben. Mit JS (src/scripts/hero-scroll.ts) wird die
 * Section zu einem 170vh hohen Track: Das Bild bleibt stehen, während die
 * Copy darüber wegscrollt, und fährt dabei von der Prozess-Seite (links) zur
 * Produktions-Seite (rechts), bis die nächste Sektion es überdeckt.
 *
 * Ohne JS, bei Reduced Motion, Data-Saver oder 2g bleibt der Track 100svh
 * hoch: ein statischer Hero. Auf Phones steht das Bild immer still.
 * Alle Scroll-Visuals: nur transform/opacity aus `--p` (DESIGN.md, 7 und 9).
 */
import { getImage } from "astro:assets";
import { hero } from "../data/content";
import heroSource from "../assets/hero.webp";

interface Props {
  imageAlt?: string;
  /** Scroll-Szene als Progressive Enhancement aktivieren (Standard: ja). */
  immersive?: boolean;
}
const { imageAlt = "", immersive = true } = Astro.props;

// LCP-Bild: drei Breiten, damit Phones nicht die 2560px-Variante laden.
const image = await getImage({
  src: heroSource,
  widths: [960, 1440, 2560],
  sizes: "100vw",
  format: "webp",
  quality: 78,
});
---

<section class="hero section--ink" data-hero={immersive ? "" : undefined}>
  <div class="hero__track" data-hero-track>
    <div class="hero__visual" data-hero-stage>
      <div class="hero__pan">
        <img
          class="hero__bg"
          src={image.src}
          srcset={image.srcSet.attribute}
          sizes="100vw"
          alt={imageAlt}
          width={image.attributes.width}
          height={image.attributes.height}
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <div class="hero__wash" aria-hidden="true"></div>
      <div class="hero__shade" aria-hidden="true"></div>
      <div class="hero__progress" aria-hidden="true"></div>
    </div>

    <div class="hero__content">
      <div class="container hero__copy">
        <div class="reveal" style="--delay: .1s"><p class="eyebrow">{hero.eyebrow}</p></div>
        <div class="reveal" style="--delay: .25s"><h1>{hero.headline}</h1></div>
        <div class="reveal" style="--delay: .4s"><p class="hero__claim">{hero.claim}</p></div>
        <div class="reveal" style="--delay: .55s"><p class="hero__desc">{hero.description}</p></div>
        <div class="hero__actions reveal" style="--delay: .7s">
          <a class="btn btn--primary" href={hero.primaryCta.href}>
            {hero.primaryCta.label}
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
          </a>
          <a class="btn btn--ghost" href={hero.secondaryCta.href}>{hero.secondaryCta.label}</a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { createHeroScene } from "../scripts/hero-scroll";

  const disposers = new Map<Element, () => void>();
  const init = () => {
    document.querySelectorAll<HTMLElement>("[data-hero]").forEach((el) => {
      if (!disposers.has(el)) disposers.set(el, createHeroScene(el));
    });
  };
  // astro:before-swap / astro:page-load: vorwärtskompatibel mit dem ClientRouter (View Transitions).
  document.addEventListener("astro:before-swap", () => {
    disposers.forEach((dispose) => dispose());
    disposers.clear();
  });
  document.addEventListener("astro:page-load", init);
  init();
</script>

<style>
  .hero {
    --hero-pad-b: clamp(48px, 8vw, 96px);
    --nav-h: 74px;
    --p: 0;
    --scene-reveal: 0;
    --scene-carry: 0;
    position: relative;
    background: var(--ink);
  }
  .hero__track {
    position: relative;
    height: 100svh;
    height: 100dvh;
    min-height: 560px;
  }

  /* Bildlayer: sticky, ein Viewport hoch. Ohne Szene hat er keinen Weg und
     steht damit still; in der Szene bleibt er stehen, während die Copy
     darüber wegscrollt. */
  .hero__visual {
    position: sticky;
    top: 0;
    height: 100svh;
    height: 100dvh;
    min-height: 560px;
    overflow: hidden;
  }
  .hero__pan {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% center;
    opacity: 0.9;
  }
  /* Farbwash: Lavendel (Prozess) links, Magenta (Produktion) rechts, per --p
     gegeneinander geblendet. Weiche lineare Verläufe, keine Leuchtflecken. */
  .hero__wash {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .hero__wash::before,
  .hero__wash::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .hero__wash::before {
    background: linear-gradient(105deg, color-mix(in oklab, var(--process) 6%, transparent) 0%, transparent 40%);
    opacity: calc(1 - var(--p));
  }
  .hero__wash::after {
    background: linear-gradient(255deg, color-mix(in oklab, var(--production) 5%, transparent) 0%, transparent 40%);
    opacity: var(--p);
  }
  .hero__shade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    /* Statischer Teil: ein Schleier über dem mittleren Band gegen das
       Einlauf-Leuchten, dazu ein leiser Markenlila-Hauch (DESIGN.md, 3). */
    background:
      linear-gradient(111deg, transparent 28%, color-mix(in oklab, var(--ink) 12%, transparent) 50%, transparent 72%),
      linear-gradient(111deg, rgba(81, 29, 150, 0.12) 0%, rgba(53, 26, 89, 0) 70%);
  }
  /* Lesbarkeits-Schleier: unten dicht, links für den Textblock. Sobald die
     Copy weggescrollt ist, zieht er sich mit --p zur Hälfte zurück, damit
     der Nachlauf das Motiv zeigt statt einer schwarzen Fläche. */
  .hero__shade::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgba(21, 4, 43, 0.96) 0%, rgba(21, 4, 43, 0.45) 45%, rgba(21, 4, 43, 0.18) 100%),
      linear-gradient(to right, rgba(21, 4, 43, 0.9) 0%, rgba(21, 4, 43, 0.55) 35%, rgba(21, 4, 43, 0) 68%);
    opacity: calc(1 - 0.5 * var(--p));
  }
  .hero__progress {
    display: none;
  }

  /* Copy: liegt über dem ersten Viewport (negativer Margin gegen den
     sticky Bildlayer) und scrollt normal mit. */
  .hero__content {
    position: relative;
    z-index: 1;
    margin-top: -100svh;
    margin-top: -100dvh;
    min-height: 100svh;
    min-height: 100dvh;
    display: flex;
    align-items: flex-end;
    padding-block: calc(var(--nav-h) + 56px) var(--hero-pad-b);
  }
  @media (min-height: 561px) {
    .hero__track, .hero__visual { min-height: 0; }
  }
  @supports not (height: 100svh) {
    .hero__track, .hero__visual, .hero__content { height: 100vh; min-height: 100vh; }
    .hero__content { margin-top: -100vh; }
  }
  .hero__copy {
    max-width: 760px;
  }
  .hero h1 {
    margin-top: 18px;
    color: var(--fg-on-ink);
  }
  .hero__claim {
    margin-top: 16px;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.6vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    color: #ffffff;
    width: fit-content;
  }
  .hero__desc {
    margin-top: 20px;
    max-width: 60ch;
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    color: var(--fg-on-ink-muted);
    text-wrap: pretty;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  /* Flache Viewports (max. 700 px hoch): Copy kompakter, nichts wird beschnitten. */
  @media (max-height: 700px) {
    .hero {
      --hero-pad-b: 24px;
    }
    .hero__content {
      padding-top: calc(var(--nav-h) + 24px);
    }
    .hero h1 {
      margin-top: 10px;
      font-size: clamp(1.75rem, 3.8vw, 2.5rem);
    }
    .hero__claim {
      margin-top: 8px;
      font-size: clamp(1.05rem, 1.8vw, 1.3rem);
    }
    .hero__desc {
      margin-top: 10px;
      max-width: 70ch;
      font-size: 0.9rem;
      line-height: 1.45;
    }
    .hero__actions {
      margin-top: 14px;
    }
    .hero__actions .btn {
      padding: 11px 16px;
      font-size: 0.9rem;
    }
  }

  /* ---------------------------------------------------------------
     Scroll-Szene (nur mit JS, gesetzt über data-scene="on")
     --------------------------------------------------------------- */
  .hero[data-scene="on"] .hero__track {
    height: 170vh;
  }
  /* Bildlayer breiter als der Viewport: Kamerafahrt von Bildlinks (Prozess)
     nach Bildrechts (Produktion), Skalierung 1.075 -> 1.015, leise Drift. */
  .hero[data-scene="on"] .hero__pan {
    width: max(178svh, 150vw);
    will-change: transform;
    transform: translate3d(calc(var(--p) * (100vw - 100%)), calc(var(--p) * -1.5%), 0)
      scale(calc(1.075 - 0.06 * var(--p)));
  }
  .hero[data-scene="on"] .hero__bg {
    object-position: 50% 40%;
  }
  /* Fortschrittslinie am unteren Bildrand: Achse in voller Breite, eine
     Aubergine-Abdeckung schiebt sich mit --p nach rechts weg. */
  .hero[data-scene="on"] .hero__progress {
    display: block;
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    overflow: hidden;
    background: var(--axis);
    z-index: 2;
  }
  .hero[data-scene="on"] .hero__progress::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--ink);
    opacity: 0.88;
    transform: translate3d(calc(var(--p) * 100%), 0, 0);
  }

  /* Phone: Bild steht still, kein Nachlauf; der Hero ist einen Viewport hoch. */
  @media (max-width: 899px) {
    .hero[data-scene="on"] .hero__track {
      height: 100svh;
      height: 100dvh;
    }
    .hero[data-scene="on"] .hero__pan {
      width: 100%;
      will-change: auto;
      transform: none;
    }
    .hero[data-scene="on"] .hero__bg {
      object-position: 70% center;
    }
    .hero[data-scene="on"] .hero__progress {
      display: none;
    }
  }

  /* Sicherheitsnetz: Reduced Motion neutralisiert die Szene auch dann,
     wenn das Skript sie bereits aktiviert hatte. */
  @media (prefers-reduced-motion: reduce) {
    .hero[data-scene="on"] .hero__track {
      height: 100svh;
      height: 100dvh;
    }
    .hero[data-scene="on"] .hero__pan {
      width: 100%;
      transform: none;
      will-change: auto;
    }
    .hero[data-scene="on"] .hero__progress {
      display: none;
    }
  }
  @media (max-width: 859px) {
    .hero { --nav-h: 65px; }
  }
</style>
