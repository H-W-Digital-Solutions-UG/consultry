---
/**
 * Hero der Startseite.
 *
 * Statischer Hero (Gründer, 2026-09-18: kein Hintergrund-Scroll mehr): Das
 * Bild liegt als Fläche hinter Copy und Nachlauf (Slot "after", Trust-Leiste).
 * Das Bild ist ein generierter, analog wirkender Lichtverlauf (Gründer,
 * 2026-09-18): mattes Flieder links oben, das diagonal in die Aubergine der
 * Seite ausläuft. Es bringt die Vignette selbst mit, deshalb liegt nur noch
 * ein leichter Schleier darüber; unten führt ein Verlauf nahtlos in die
 * nächste Sektion. Keine Leuchtflecken, kein Glow.
 */
import { getImage } from "astro:assets";
import { hero } from "../data/content";
import heroSource from "../assets/hero.webp";

interface Props {
  imageAlt?: string;
}
const { imageAlt = "" } = Astro.props;

// LCP-Bild: drei Breiten, damit Phones nicht die 2560px-Variante laden.
const image = await getImage({
  src: heroSource,
  widths: [960, 1440, 2560],
  sizes: "100vw",
  format: "webp",
  quality: 78,
});
---

<section class="hero section--ink">
  <div class="hero__visual" aria-hidden="true">
    <img
      class="hero__bg"
      src={image.src}
      srcset={image.srcSet.attribute}
      sizes="100vw"
      alt={imageAlt}
      width={image.attributes.width}
      height={image.attributes.height}
      fetchpriority="high"
      decoding="async"
    />
    <div class="hero__shade"></div>
  </div>

  <div class="hero__content">
    <div class="container hero__copy">
      <div class="reveal" style="--delay: .04s"><p class="eyebrow">{hero.eyebrow}</p></div>
      <div class="reveal" style="--delay: .1s"><h1>{hero.headline}</h1></div>
      <div class="reveal" style="--delay: .16s"><p class="hero__claim">{hero.claim}</p></div>
      <div class="reveal" style="--delay: .22s"><p class="hero__desc">{hero.description}</p></div>
      <div class="hero__actions reveal" style="--delay: .28s">
        <a class="btn btn--primary" href={hero.primaryCta.href}>
          {hero.primaryCta.label}
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
        </a>
        <a class="btn btn--ghost" href={hero.secondaryCta.href}>{hero.secondaryCta.label}</a>
      </div>
    </div>
  </div>

  <!-- Nachlauf: Trust-Leiste auf dem unteren, in Aubergine auslaufenden Bildrand. -->
  <div class="hero__after">
    <slot name="after" />
  </div>
</section>

<style>
  .hero {
    --nav-h: 74px;
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: 1fr auto;
    min-height: 100svh;
    min-height: 100dvh;
    background: var(--ink);
    overflow: hidden;
  }

  /* Bildfläche hinter allem. Entsättigt und abgedunkelt: das Motiv trägt
     Stimmung, nicht Leuchtkraft. */
  .hero__visual {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 30% 42%;
    filter: saturate(0.92) brightness(1);
  }
  /* Leichter Schleier: Das Bild trägt seine Vignette selbst. Hier nur der
     Verlauf nach unten in die Aubergine (nahtloser Übergang zur Leiste), ein
     Hauch von links für die Lesbarkeit und ein Hauch von oben unter der Nav. */
  .hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, rgba(21, 4, 43, 1) 0%, rgba(21, 4, 43, 0.55) 16%, rgba(21, 4, 43, 0) 40%),
      linear-gradient(to right, rgba(21, 4, 43, 0.14) 0%, rgba(21, 4, 43, 0) 40%),
      linear-gradient(to bottom, rgba(21, 4, 43, 0.3) 0%, rgba(21, 4, 43, 0) 20%);
  }

  /* Copy: vertikal in der Bildfläche zentriert, bündig mit der Container-Kante. */
  .hero__content {
    display: flex;
    align-items: center;
    padding-block: calc(var(--nav-h) + clamp(32px, 8vh, 96px)) clamp(28px, 5vh, 56px);
  }
  .hero__copy > * {
    max-width: 760px;
  }
  /* Die Headline darf breiter laufen, damit jeder Satz auf einer Zeile bleibt. */
  .hero__copy > *:has(> h1),
  .hero__copy > *:has(> .hero__claim) {
    max-width: 1080px;
  }
  .hero h1 {
    margin-top: 18px;
    max-width: none;
    font-size: clamp(2.1rem, 5.4vw, 4.4rem);
    white-space: pre-line;
    color: var(--fg-on-ink);
  }
  .hero__claim {
    margin-top: 16px;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.6vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    color: #ffffff;
    width: fit-content;
  }
  .hero__desc {
    margin-top: 20px;
    max-width: 60ch;
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    color: var(--fg-on-ink-muted);
    text-wrap: pretty;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  /* Nachlauf: Trust-Leiste auf dem in Aubergine ausgelaufenen Bildrand. */
  .hero__after {
    min-width: 0;
    padding-block: 0 24px;
  }
  .hero__after:empty { display: none; }

  /* Flache Viewports (max. 700 px hoch): Copy kompakter, nichts wird beschnitten. */
  @media (max-height: 700px) {
    .hero__content {
      padding-top: calc(var(--nav-h) + 24px);
      padding-bottom: 20px;
    }
    .hero h1 {
      margin-top: 10px;
      font-size: clamp(1.75rem, 3.8vw, 2.5rem);
    }
    .hero__claim {
      margin-top: 8px;
      font-size: clamp(1.05rem, 1.8vw, 1.3rem);
    }
    .hero__desc {
      margin-top: 10px;
      max-width: 70ch;
      font-size: 0.9rem;
      line-height: 1.45;
    }
    .hero__actions {
      margin-top: 14px;
    }
    .hero__actions .btn {
      padding: 11px 16px;
      font-size: 0.9rem;
    }
  }

  @media (max-width: 899px) {
    .hero__bg { object-position: 22% center; }
    .hero__shade {
      background:
        linear-gradient(to top, rgba(21, 4, 43, 1) 0%, rgba(21, 4, 43, 0.7) 28%, rgba(21, 4, 43, 0.15) 65%, rgba(21, 4, 43, 0.3) 100%);
    }
    .hero__after { padding-block: 8px 28px; }
  }
  @media (max-width: 859px) {
    .hero { --nav-h: 65px; }
  }
</style>
