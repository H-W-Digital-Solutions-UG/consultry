---
/**
 * Hero der Startseite – „From Process to Production“.
 *
 * Grundzustand (ohne JS, Reduced Motion, Data-Saver, 2g): statischer
 * 100svh-Hero mit Bild, Schleier, Copy und den drei Beats als einfache Liste.
 * Mit JS (src/scripts/hero-scroll.ts) wird die Section zu einem hohen Track,
 * die Bühne bleibt angepinnt, das breite Bild fährt von der Prozess-Seite
 * (links) zur Produktions-Seite (rechts); Beats und Annotationen 01–03
 * erscheinen nacheinander. Alle Scroll-Visuals: nur transform/opacity aus
 * `--p`, `--scene-reveal`, `--scene-carry` (siehe DESIGN.md, Abschnitt 9).
 */
import { hero, heroBeats } from "../data/content";

interface Props {
  image?: string;
  imageAlt?: string;
  /** Scroll-Szene als Progressive Enhancement aktivieren (Standard: ja). */
  immersive?: boolean;
}
const { image = "/images/hero.webp", imageAlt = "", immersive = true } = Astro.props;
---

<section class="hero section--ink" data-hero={immersive ? "" : undefined} data-scene-share="0.5">
  <div class="hero__track" data-hero-track>
    <div class="hero__stage" data-hero-stage>
      <div class="hero__visual">
        <div class="hero__pan">
          <img class="hero__bg" src={image} alt={imageAlt} width="2560" height="1434" fetchpriority="high" decoding="async" />
          <div class="hero__notes" aria-hidden="true">
            {heroBeats.map((beat, i) => (
              <span class={`hero__note hero__note--${i + 1}`} data-note={i + 1}>{beat.n}</span>
            ))}
          </div>
        </div>
        <div class="hero__wash" aria-hidden="true"></div>
        <div class="hero__shade" aria-hidden="true"></div>
      </div>

      <div class="container hero__content">
        <div class="hero__copy" data-hero-copy>
          <p class="eyebrow reveal" style="--delay: .1s">{hero.eyebrow}</p>
          <h1 class="reveal" style="--delay: .25s">{hero.headline}</h1>
          <p class="hero__claim reveal" style="--delay: .4s">{hero.claim}</p>
          <p class="hero__desc reveal" style="--delay: .55s">{hero.description}</p>
          <div class="hero__actions reveal" style="--delay: .7s">
            <a class="btn btn--primary" href={hero.primaryCta.href}>
              {hero.primaryCta.label}
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
            </a>
            <a class="btn btn--ghost" href={hero.secondaryCta.href}>{hero.secondaryCta.label}</a>
          </div>
        </div>

        <ol class="hero__beats" aria-label="Vom Prozess zur Produktion in drei Schritten">
          {heroBeats.map((beat, i) => (
            <li class="hero__beat" data-beat={i + 1}>
              <span class="hero__beat-n" aria-hidden="true">{beat.n}</span>
              <div class="hero__beat-body">
                <h2 class="hero__beat-title">{beat.title}</h2>
                <p class="hero__beat-text">{beat.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <div class="hero__progress" aria-hidden="true"></div>
    </div>
  </div>
</section>

<script>
  import { createHeroScene } from "../scripts/hero-scroll";

  const disposers = new Map<Element, () => void>();
  const init = () => {
    document.querySelectorAll<HTMLElement>("[data-hero]").forEach((el) => {
      if (!disposers.has(el)) disposers.set(el, createHeroScene(el));
    });
  };
  document.addEventListener("astro:before-swap", () => {
    disposers.forEach((dispose) => dispose());
    disposers.clear();
  });
  document.addEventListener("astro:page-load", init);
  init();
</script>

<style>
  /* ---------------------------------------------------------------
     Grundzustand: statischer Hero (kein JS / Reduced Motion / Data-Saver)
     --------------------------------------------------------------- */
  .hero {
    --hero-pad-b: clamp(48px, 8vw, 96px);
    --p: 0;
    --scene-reveal: 0;
    --scene-carry: 0;
    position: relative;
    background: var(--ink);
  }
  .hero__track {
    position: relative;
  }
  .hero__stage {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .hero__visual {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .hero__pan {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }
  .hero__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% center;
    opacity: 0.9;
  }
  /* Farbwash: Lavendel (Prozess) links, Magenta (Produktion) rechts – weiche
     lineare Verläufe, je max. 10 % Deckkraft, per --p gegeneinander geblendet. */
  .hero__wash {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .hero__wash::before,
  .hero__wash::after {
    content: "";
    position: absolute;
    inset: 0;
  }
  .hero__wash::before {
    background: linear-gradient(105deg, var(--process) 0%, rgba(169, 139, 255, 0) 65%);
    opacity: calc(0.1 * (1 - var(--p)));
  }
  .hero__wash::after {
    background: linear-gradient(255deg, var(--production) 0%, rgba(211, 108, 240, 0) 65%);
    opacity: calc(0.1 * var(--p));
  }
  .hero__shade {
    position: absolute;
    inset: 0;
    pointer-events: none;
    /* Aubergine-Schleier: unten dicht für Lesbarkeit, links für den Textblock,
       dazu ein leiser Markenlila-Hauch (DESIGN.md, Abschnitt 3). */
    background:
      linear-gradient(to top, rgba(21, 4, 43, 0.96) 0%, rgba(21, 4, 43, 0.6) 45%, rgba(21, 4, 43, 0.18) 100%),
      linear-gradient(to right, rgba(21, 4, 43, 0.78) 0%, rgba(21, 4, 43, 0) 60%),
      linear-gradient(111deg, rgba(81, 29, 150, 0.12) 0%, rgba(53, 26, 89, 0) 70%);
  }

  /* Annotationen 01–03 auf dem Bild: nur in der Scroll-Szene sichtbar. */
  .hero__notes {
    display: none;
  }

  /* Inhalt */
  .hero__content {
    position: relative;
    z-index: 1;
    padding-block: 140px var(--hero-pad-b);
    margin-inline: var(--gutter);
    width: auto;
  }
  .hero__copy {
    max-width: 760px;
  }
  .hero h1 {
    margin-top: 18px;
    color: var(--fg-on-ink);
  }
  .hero__claim {
    margin-top: 16px;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2.2vw, 1.7rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    /* Claim trägt die Achse: Lavendel -> Magenta, Magenta nur am Ende */
    background: linear-gradient(90deg, var(--accent-on-ink) 0%, var(--process) 55%, var(--production) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    width: fit-content;
  }
  .hero__desc {
    margin-top: 20px;
    max-width: 60ch;
    font-size: clamp(1rem, 1.4vw, 1.2rem);
    color: var(--fg-on-ink-muted);
    text-wrap: pretty;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  /* Beats – Ziffer leicht (Sora 300) neben kurzem Titel, Text darunter. */
  .hero__beats {
    list-style: none;
    margin: 40px 0 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .hero__beat {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 14px;
    align-items: baseline;
    padding: 12px 14px;
    border: 1px solid transparent;
    border-radius: var(--radius);
  }
  .hero__beat-n {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 1.5rem;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    color: var(--accent-on-ink);
  }
  .hero__beat-title {
    font-size: 1.05rem;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--fg-on-ink);
  }
  .hero__beat-text {
    margin-top: 6px;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--fg-on-ink-muted);
    text-wrap: pretty;
  }

  .hero__progress {
    display: none;
  }

  @media (min-width: 900px) {
    .hero__content {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(280px, 360px);
      align-items: end;
      column-gap: 56px;
    }
    .hero__beats {
      margin-top: 0;
    }
  }
  @media (min-width: 1296px) {
    .hero__content {
      margin-inline: auto;
      width: min(100% - 2 * var(--gutter), var(--container));
    }
  }

  /* ---------------------------------------------------------------
     Scroll-Szene (nur mit JS, gesetzt über data-scene="on")
     --------------------------------------------------------------- */
  .hero[data-scene="on"] .hero__track {
    height: 260vh;
  }
  .hero[data-scene="on"] .hero__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 0;
  }
  /* Bildlayer breiter als der Viewport: eine Kamerafahrt von Bildlinks
     (Prozess-Knoten) nach Bildrechts (Produktion), dazu Skalierung 1.06 -> 1
     und eine leise vertikale Drift. Linear an den Scroll gekoppelt. */
  .hero[data-scene="on"] .hero__pan {
    width: max(178svh, 150vw);
    will-change: transform;
    transform: translate3d(calc(var(--p) * (100vw - 100%)), calc(var(--p) * -1.5%), 0)
      scale(calc(1.06 - 0.06 * var(--p)));
  }
  .hero[data-scene="on"] .hero__bg {
    object-position: 50% 40%;
  }

  .hero[data-scene="on"] .hero__notes {
    display: block;
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .hero__note {
    position: absolute;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    margin: -15px 0 0 -15px;
    border-radius: 50%;
    font-family: var(--font-display);
    font-size: 0.74rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: var(--fg-on-ink);
    background: rgba(21, 4, 43, 0.86);
    border: 1px solid var(--line-on-ink-strong);
    opacity: calc(var(--scene-reveal) * 0.55);
    transition: color 0.24s, border-color 0.24s, background-color 0.24s;
  }
  .hero__note--1 { left: 24%; top: 26%; }
  .hero__note--2 { left: 54%; top: 32%; }
  .hero__note--3 { left: 78%; top: 45%; }
  .hero[data-scene-aspect="1"] .hero__note--1,
  .hero[data-scene-aspect="2"] :is(.hero__note--1, .hero__note--2),
  .hero[data-scene-aspect="3"] .hero__note {
    opacity: var(--scene-reveal);
    color: var(--accent-on-ink);
    border-color: var(--accent-on-ink);
    background: rgba(21, 4, 43, 0.92);
  }
  .hero[data-scene-aspect="3"] .hero__note--3 {
    color: var(--production);
    border-color: var(--production);
  }

  /* Copy tritt zurück, sobald die Beats den Fokus übernehmen. */
  .hero[data-scene="on"] .hero__copy {
    transition: opacity 0.4s var(--ease-out), transform 0.4s var(--ease-out);
  }
  .hero[data-scene="on"] .hero__copy[data-faded="true"] {
    opacity: 0.35;
    transform: translateY(-14px);
  }

  /* Beats erscheinen nacheinander (240 ms fade/translate) und bleiben stehen;
     der aktive Beat erhält einen ruhigen Flächenwechsel statt Glow. */
  .hero[data-scene="on"] .hero__beat {
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.24s var(--ease-out),
      transform 0.24s var(--ease-out),
      background-color 0.24s,
      border-color 0.24s;
  }
  .hero[data-scene="on"] .hero__beat-n,
  .hero[data-scene="on"] .hero__beat-title,
  .hero[data-scene="on"] .hero__beat-text {
    transition: color 0.24s, opacity 0.24s;
  }
  .hero[data-scene="on"] .hero__beat-n {
    color: var(--fg-on-ink-muted);
  }
  .hero[data-scene="on"] .hero__beat-title {
    color: var(--fg-on-ink-muted);
  }
  .hero[data-scene="on"] .hero__beat-text {
    opacity: 0.75;
  }
  .hero[data-scene-aspect="1"] .hero__beat[data-beat="1"],
  .hero[data-scene-aspect="2"] :is(.hero__beat[data-beat="1"], .hero__beat[data-beat="2"]),
  .hero[data-scene-aspect="3"] .hero__beat {
    opacity: 1;
    transform: none;
  }
  .hero[data-scene-aspect="1"] .hero__beat[data-beat="1"],
  .hero[data-scene-aspect="2"] .hero__beat[data-beat="2"],
  .hero[data-scene-aspect="3"] .hero__beat[data-beat="3"] {
    background: rgba(245, 241, 251, 0.06);
    border-color: var(--line-on-ink);
  }
  .hero[data-scene-aspect="1"] .hero__beat[data-beat="1"] .hero__beat-n,
  .hero[data-scene-aspect="2"] .hero__beat[data-beat="2"] .hero__beat-n {
    color: var(--accent-on-ink);
  }
  .hero[data-scene-aspect="3"] .hero__beat[data-beat="3"] .hero__beat-n {
    color: var(--production);
  }
  .hero[data-scene-aspect="1"] .hero__beat[data-beat="1"] .hero__beat-title,
  .hero[data-scene-aspect="2"] .hero__beat[data-beat="2"] .hero__beat-title,
  .hero[data-scene-aspect="3"] .hero__beat[data-beat="3"] .hero__beat-title {
    color: var(--fg-on-ink);
  }
  .hero[data-scene-aspect="1"] .hero__beat[data-beat="1"] .hero__beat-text,
  .hero[data-scene-aspect="2"] .hero__beat[data-beat="2"] .hero__beat-text,
  .hero[data-scene-aspect="3"] .hero__beat[data-beat="3"] .hero__beat-text {
    opacity: 1;
  }

  /* Fortschrittslinie: Achse in voller Breite, eine Aubergine-Abdeckung
     schiebt sich mit --p nach rechts weg – Magenta bleibt am Ende. */
  .hero[data-scene="on"] .hero__progress {
    display: block;
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    overflow: hidden;
    background: var(--axis);
    z-index: 2;
  }
  .hero[data-scene="on"] .hero__progress::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--ink);
    opacity: 0.88;
    transform: translate3d(calc(var(--p) * 100%), 0, 0);
  }

  /* Mobil: kürzerer Track; nur der aktive Beat unten, Copy weicht nach oben.
     Annotationen sitzen am oberen Rand der Motive, damit sie nicht in die
     zurückgetretene Copy fallen. */
  @media (max-width: 899px) {
    .hero[data-scene="on"] .hero__track {
      height: 200vh;
    }
    .hero__note--1 { top: 13%; }
    .hero__note--2 { top: 15%; }
    .hero__note--3 { top: 14%; }
    .hero[data-scene="on"] .hero__beats {
      position: absolute;
      left: 0;
      right: 0;
      bottom: var(--hero-pad-b);
      margin: 0;
      min-height: 120px;
    }
    .hero[data-scene="on"] .hero__beat {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
    }
    .hero[data-scene-aspect="2"] .hero__beat[data-beat="1"],
    .hero[data-scene-aspect="3"] :is(.hero__beat[data-beat="1"], .hero__beat[data-beat="2"]) {
      opacity: 0;
      transform: translateY(-10px);
    }
    .hero[data-scene="on"]:not([data-scene-aspect="0"]) .hero__copy {
      opacity: 0.35;
      transform: translateY(-150px);
    }
  }

  /* Sicherheitsnetz: Reduced Motion neutralisiert die Szene auch dann,
     wenn das Skript sie bereits aktiviert hatte. */
  @media (prefers-reduced-motion: reduce) {
    .hero[data-scene="on"] .hero__track {
      height: auto;
    }
    .hero[data-scene="on"] .hero__stage {
      position: relative;
      height: auto;
      min-height: 100svh;
    }
    .hero[data-scene="on"] .hero__pan {
      width: 100%;
      transform: none;
      will-change: auto;
    }
    .hero[data-scene="on"] .hero__notes,
    .hero[data-scene="on"] .hero__progress {
      display: none;
    }
    .hero[data-scene="on"] .hero__copy,
    .hero[data-scene="on"] .hero__beat {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .hero[data-scene="on"] .hero__beats {
      position: static;
    }
    .hero[data-scene="on"] .hero__beat {
      position: static;
    }
  }
</style>
