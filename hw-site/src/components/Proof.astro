---
/**
 * Nachweise: Zertifizierungen im Gründerteam und Partner.
 * Badges und Logos stammen von der bisherigen Website (Freigabe der Gründer,
 * 2026-09-17). Partnerlogos werden als CSS-Maske einfarbig gerendert, damit
 * fünf fremde Marken nicht fünf Farbwelten in die Seite tragen.
 *
 * variant="strip": nahtlose Partner-Logoleiste im Hero-Nachlauf (Slot "after"
 *   von Hero.astro): ohne Label, volle Breite, weiche Ränder, läuft langsam
 *   und endlos (zwei identische Listen, Track fährt um 50 %). Ohne Bewegung
 *   bei Reduced Motion. Zertifikate stehen in der Proof-Szene „Wer bei uns
 *   baut“ (Gründer, 2026-09-18).
 * variant="full":  Unternehmensseite mit Namen und Ausstellern, dazu Partner.
 */
import { Image, getImage } from "astro:assets";
import { certifications, partners } from "../data/content";

interface Props {
  variant?: "strip" | "full";
}
const { variant = "full" } = Astro.props;
const strip = variant === "strip";

const badgeFiles = import.meta.glob<{ default: ImageMetadata }>("../assets/certs/*.png", { eager: true });
const logoFiles = import.meta.glob<{ default: ImageMetadata }>("../assets/partners/*.png", { eager: true });
const badge = (file: string) => badgeFiles[`../assets/certs/${file}`]?.default;

/**
 * Partnerlogos laufen als CSS-Maske und werden 22 px (mobil) bis 32 px hoch
 * gezeigt. Die Quell-PNGs sind bis zu 75 KB groß; für die Maske zählt allein
 * der Alphakanal, die Farbkanäle wirft sie weg. Wir rendern sie deshalb einmal
 * als WebP mit 72 px Höhe und niedriger Farbqualität vor: mehr als das Doppelte
 * der größten Anzeigehöhe, also auch auf Retina-Displays scharf. Aus 203 KB
 * werden so rund 30 KB. Die Leiste steht auf beiden Größen im ersten Bild und
 * lädt deshalb mit, sie ist kein Kandidat fürs Nachladen.
 */
const logoMasks = new Map<string, { src: string; ratio: number }>();
for (const p of partners) {
  const img = logoFiles[`../assets/partners/${p.file}`]?.default;
  if (!img) continue;
  const ratio = img.width / img.height;
  const rendered = await getImage({ src: img, width: Math.round(72 * ratio), height: 72, format: "webp", quality: 20 });
  logoMasks.set(p.file, { src: rendered.src, ratio });
}
const logo = (file: string) => logoMasks.get(file);
---

{strip ? (
  <div class="strip" aria-label="Partner">
    <div class="strip__track">
      {[0, 1].map((copy) => (
        <ul class="strip__partners" aria-hidden={copy === 1 ? "true" : undefined}>
          {partners.map((p) => {
            const img = logo(p.file);
            return (
              <li>
                <a class="logo-link" href={p.href} rel="noopener" target="_blank" aria-label={`${p.name} (öffnet in neuem Tab)`} tabindex={copy === 1 ? -1 : undefined}>
                  {img && <span class="logo" style={`--logo: url(${img.src}); --ratio: ${img.ratio.toFixed(3)}`} aria-hidden="true"></span>}
                </a>
              </li>
            );
          })}
        </ul>
      ))}
    </div>
  </div>
) : (
  <div class="full">
    <div class="full__block">
      <p class="full__label">Zertifizierungen im Gründerteam</p>
      <ul class="certs">
        {certifications.map((c) => {
          const img = badge(c.file);
          return (
            <li class="cert">
              {img && <Image src={img} alt="" width={96} densities={[1, 2]} loading="lazy" />}
              <span class="cert__name">{c.name}</span>
              <span class="cert__issuer">{c.issuer}</span>
            </li>
          );
        })}
      </ul>
    </div>

    <div class="full__row">
      <div class="full__block">
        <p class="full__label">Partner</p>
        <ul class="full__partners">
          {partners.map((p) => {
            const img = logo(p.file);
            return (
              <li>
                <a class="logo-link" href={p.href} rel="noopener" target="_blank" aria-label={`${p.name} (öffnet in neuem Tab)`}>
                  {img && <span class="logo" style={`--logo: url(${img.src}); --ratio: ${img.ratio.toFixed(3)}`} aria-hidden="true"></span>}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </div>
  </div>
)}

<style>
  /* ---- gemeinsam: einfarbige Partnerlogos ---- */
  .logo-link { display: inline-flex; align-items: center; height: 40px; opacity: 0.66; transition: opacity 0.2s; }
  .logo-link:hover, .logo-link:focus-visible { opacity: 1; }
  .logo {
    display: block;
    height: var(--logo-h, 22px);
    width: calc(var(--logo-h, 22px) * var(--ratio, 4));
    max-width: 150px;
    background: currentColor;
    -webkit-mask: var(--logo) center / contain no-repeat;
    mask: var(--logo) center / contain no-repeat;
  }

  /* ---- Nahtlose Logoleiste ---- */
  :global(.section--ink) .logo-link { opacity: 0.78; color: var(--fg-on-ink); }
  :global(.section--ink) .logo-link:hover { opacity: 1; }
  .strip {
    --logo-h: 32px;
    overflow: hidden;
    padding-block: 18px;
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 10%, #000 90%, transparent 100%);
    mask-image: linear-gradient(to right, transparent 0, #000 10%, #000 90%, transparent 100%);
    animation: fade-in 0.8s var(--ease-out) 0.9s both;
  }
  .strip__track {
    display: flex;
    width: max-content;
    animation: marquee 46s linear infinite;
  }
  .strip:hover .strip__track { animation-play-state: paused; }
  .strip__partners {
    list-style: none; margin: 0; padding: 0 0 0 72px;
    display: flex; align-items: center; gap: 72px;
    flex: none;
  }
  .strip__partners .logo { max-width: 220px; }
  .logo-link { height: 44px; }
  @keyframes marquee { to { transform: translateX(-50%); } }
  @keyframes fade-in { from { opacity: 0; } to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) {
    .strip { animation: none; -webkit-mask-image: none; mask-image: none; }
    .strip__track { animation: none; width: auto; flex-wrap: wrap; }
    .strip__partners { padding-left: 0; flex-wrap: wrap; gap: 12px 40px; }
    .strip__partners[aria-hidden] { display: none; }
  }
  @media (max-width: 599px) {
    .strip { --logo-h: 24px; padding-block: 12px; }
    .strip__partners { gap: 44px; padding-left: 44px; }
    .strip__track { animation-duration: 30s; }
  }

  /* ---- Volle Sektion ---- */
  .full { display: grid; gap: 48px; }
  .full__label {
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--fg-muted);
    margin-bottom: 18px;
  }
  .certs {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: 1px;
    grid-template-columns: repeat(2, 1fr);
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  @media (min-width: 720px) { .certs { grid-template-columns: repeat(4, 1fr); } }
  .cert {
    background: var(--paper);
    padding: 26px 20px 24px;
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 4px;
    transition: background-color 0.2s;
  }
  .cert:hover { background: var(--paper-2); }
  .cert img { display: block; width: 96px; height: auto; margin-bottom: 12px; }
  .cert__name { font-family: var(--font-display); font-weight: 600; font-size: 0.98rem; letter-spacing: -0.01em; line-height: 1.25; text-wrap: balance; }
  .cert__issuer { font-size: 0.82rem; color: var(--fg-muted); text-wrap: balance; }

  .full__row { display: grid; gap: 40px; }
  .full__partners { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 34px; align-items: center; --logo-h: 24px; }
</style>
