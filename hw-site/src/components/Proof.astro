---
/**
 * Nachweise: Zertifizierungen im Gründerteam, Standards, Partner.
 * Badges und Logos stammen von der bisherigen Website (Freigabe der Gründer,
 * 2026-09-17). Partnerlogos werden als CSS-Maske einfarbig gerendert, damit
 * fünf fremde Marken nicht fünf Farbwelten in die Seite tragen.
 *
 * variant="strip": Trust-Leiste im Hero-Nachlauf (Slot "after" von Hero.astro):
 *   Zertifikate links, Partner rechts. In der Scroll-Szene blenden die
 *   Elemente über `--p` (vom Hero geerbt) gestaffelt ein; `--start` je
 *   Element legt fest, ab welchem Fortschritt es erscheint.
 * variant="full":  Unternehmensseite mit Namen, Ausstellern, Standards.
 */
import { Image } from "astro:assets";
import { certifications, standards, partners } from "../data/content";

interface Props {
  variant?: "strip" | "full";
}
const { variant = "full" } = Astro.props;
const strip = variant === "strip";

const badgeFiles = import.meta.glob<{ default: ImageMetadata }>("../assets/certs/*.png", { eager: true });
const logoFiles = import.meta.glob<{ default: ImageMetadata }>("../assets/partners/*.png", { eager: true });
const badge = (file: string) => badgeFiles[`../assets/certs/${file}`]?.default;
const logo = (file: string) => logoFiles[`../assets/partners/${file}`]?.default;
---

{strip ? (
  <div class="strip">
    <div class="strip__group strip__group--certs">
      <a class="strip__label" href="/unternehmen#nachweise" style="--start: 0.06">
        <span>Zertifiziert im Gründerteam</span>
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
      </a>
      <ul class="strip__badges">
        {certifications.map((c, i) => {
          const img = badge(c.file);
          return (
            <li style={`--start: ${(0.12 + i * 0.045).toFixed(3)}`}>
              {img && <Image src={img} alt={`${c.name} (${c.issuer})`} title={`${c.name}, ${c.issuer}`} width={64} densities={[1, 2]} loading="lazy" />}
            </li>
          );
        })}
      </ul>
    </div>
    <div class="strip__group strip__group--partners">
      <p class="strip__label" style="--start: 0.24"><span>Partner</span></p>
      <ul class="strip__partners">
        {partners.map((p, i) => {
          const img = logo(p.file);
          return (
            <li style={`--start: ${(0.3 + i * 0.06).toFixed(3)}`}>
              <a class="logo-link" href={p.href} rel="noopener" target="_blank" aria-label={`${p.name} (öffnet in neuem Tab)`}>
                {img && <span class="logo" style={`--logo: url(${img.src}); --ratio: ${(img.width / img.height).toFixed(3)}`} aria-hidden="true"></span>}
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </div>
) : (
  <div class="full">
    <div class="full__block">
      <p class="full__label">Zertifizierungen im Gründerteam</p>
      <ul class="certs">
        {certifications.map((c) => {
          const img = badge(c.file);
          return (
            <li class="cert">
              {img && <Image src={img} alt="" width={96} densities={[1, 2]} loading="lazy" />}
              <span class="cert__name">{c.name}</span>
              <span class="cert__issuer">{c.issuer}</span>
            </li>
          );
        })}
      </ul>
    </div>

    <div class="full__row">
      <div class="full__block">
        <p class="full__label">Standards, an denen wir uns orientieren</p>
        <ul class="standards">
          {standards.map((s) => <li>{s}</li>)}
        </ul>
      </div>
      <div class="full__block">
        <p class="full__label">Partner</p>
        <ul class="full__partners">
          {partners.map((p) => {
            const img = logo(p.file);
            return (
              <li>
                <a class="logo-link" href={p.href} rel="noopener" target="_blank" aria-label={`${p.name} (öffnet in neuem Tab)`}>
                  {img && <span class="logo" style={`--logo: url(${img.src}); --ratio: ${(img.width / img.height).toFixed(3)}`} aria-hidden="true"></span>}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </div>
  </div>
)}

<style>
  /* ---- gemeinsam: einfarbige Partnerlogos ---- */
  .logo-link { display: inline-flex; align-items: center; height: 40px; opacity: 0.66; transition: opacity 0.2s; }
  .logo-link:hover, .logo-link:focus-visible { opacity: 1; }
  .logo {
    display: block;
    height: var(--logo-h, 22px);
    width: calc(var(--logo-h, 22px) * var(--ratio, 4));
    max-width: 150px;
    background: currentColor;
    -webkit-mask: var(--logo) center / contain no-repeat;
    mask: var(--logo) center / contain no-repeat;
  }

  /* ---- Trust-Leiste ---- */
  /* Auf Aubergine (im Hero-Nachlauf): helle Labels, Badges leicht gedämpft. */
  :global(.section--ink) .strip__label { color: var(--fg-on-ink-muted); }
  :global(.section--ink) a.strip__label:hover { color: var(--fg-on-ink); }
  :global(.section--ink) .strip__badges img { filter: saturate(0.35); opacity: 0.9; }
  :global(.section--ink) .strip__badges li:hover img { filter: none; opacity: 1; }
  :global(.section--ink) .logo-link { opacity: 0.8; color: var(--fg-on-ink); }
  :global(.section--ink) .logo-link:hover { opacity: 1; }
  /* Zwei Reihen: Label links, Elemente rechts, Haarlinie dazwischen. */
  .strip { display: grid; }
  .strip__group {
    display: grid;
    gap: 12px;
    padding-block: 14px;
    align-items: center;
  }
  .strip__group + .strip__group { border-top: 1px solid var(--line); }
  :global(.section--ink) .strip__group + .strip__group { border-top-color: var(--line-on-ink); }
  @media (min-width: 900px) {
    .strip__group { grid-template-columns: 240px 1fr; gap: 32px; }
  }
  .strip__label {
    display: inline-flex; align-items: center; gap: 8px;
    margin: 0;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    color: var(--fg-muted);
    text-decoration: none;
  }
  .strip__label svg { width: 14px; height: 14px; transition: transform 0.2s var(--ease-out); }
  a.strip__label:hover { color: var(--fg); }
  a.strip__label:hover svg { transform: translateX(3px); }
  .strip__badges, .strip__partners { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; align-items: center; }
  .strip__badges { gap: 14px; }
  .strip__badges li { display: flex; }
  .strip__badges img {
    display: block; width: 64px; height: auto;
    filter: saturate(0.15);
    opacity: 0.85;
    transition: filter 0.25s, opacity 0.25s, transform 0.25s var(--ease-out);
  }
  .strip__badges li:hover img, .strip__badges li:focus-within img { filter: none; opacity: 1; transform: translateY(-2px); }
  .strip__partners { gap: 8px 36px; --logo-h: 28px; }
  .strip__partners .logo { max-width: 190px; }

  /* Scroll-Stagger in der Hero-Szene: jedes Element hat --start; über 28 %
     des Fortschritts blendet es ein und rückt 16px nach oben. Nur
     transform/opacity, keine Transition (an den Scroll gekoppelt). */
  :global(.hero[data-scene="on"]) :is(.strip__label, .strip__badges li, .strip__partners li) {
    --t: clamp(0, calc((var(--p, 1) - var(--start, 0)) / 0.28), 1);
    opacity: var(--t);
    transform: translateY(calc((1 - var(--t)) * 16px));
  }
  @media (max-width: 899px), (prefers-reduced-motion: reduce) {
    :global(.hero[data-scene="on"]) :is(.strip__label, .strip__badges li, .strip__partners li) {
      opacity: 1;
      transform: none;
    }
  }
  @media (max-width: 599px) {
    .strip__badges { gap: 10px; }
    .strip__badges img { width: 48px; }
    .strip__partners { gap: 6px 24px; --logo-h: 22px; }
  }

  /* ---- Volle Sektion ---- */
  .full { display: grid; gap: 48px; }
  .full__label {
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--fg-muted);
    margin-bottom: 18px;
  }
  .certs {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: 1px;
    grid-template-columns: repeat(2, 1fr);
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  @media (min-width: 720px) { .certs { grid-template-columns: repeat(4, 1fr); } }
  .cert {
    background: var(--paper);
    padding: 26px 20px 24px;
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 4px;
    transition: background-color 0.2s;
  }
  .cert:hover { background: var(--paper-2); }
  .cert img { display: block; width: 96px; height: auto; margin-bottom: 12px; }
  .cert__name { font-family: var(--font-display); font-weight: 600; font-size: 0.98rem; letter-spacing: -0.01em; line-height: 1.25; text-wrap: balance; }
  .cert__issuer { font-size: 0.82rem; color: var(--fg-muted); text-wrap: balance; }

  .full__row { display: grid; gap: 40px; }
  @media (min-width: 900px) { .full__row { grid-template-columns: 1fr 1fr; gap: 64px; } }
  .standards { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .standards li {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    padding: 7px 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--paper);
  }
  .full__partners { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 34px; align-items: center; --logo-h: 24px; }
</style>
