---
/**
 * Die zehn Schritte als Card-Slider (Leistungen-Seite).
 *
 * Nativ per Scroll-Snap: Ohne JS ist es eine horizontal scrollbare Liste.
 * Das kleine Skript ergänzt Pfeile, Phasen-Tabs (springen zur ersten Karte
 * der Phase), die aktive Phase beim Scrollen und eine Fortschrittslinie.
 * Ab 900px und ohne Reduced Motion wird der Slider angepinnt („Scroll-Lock“):
 * Die Sektion bekommt einen hohen Wrapper, der Slider bleibt sticky, und das
 * vertikale Scrollen fährt die Karten horizontal. Kein Autoplay, keine Library.
 */
import { deliverySteps } from "../data/content";
import Icon from "./Icon.astro";
import type { IconName } from "../icons/icons";

const phaseLabel: Record<string, string> = {
  process: "Prozess",
  design: "Design",
  build: "Engineering",
  production: "Produktion",
};

// Icon je Schrittnummer (Daten in content.ts bleiben unverändert)
const stepIcon: Record<number, IconName> = {
  1: "step-understand",
  2: "step-detect",
  3: "step-potential",
  4: "step-evaluate",
  5: "step-redesign",
  6: "step-roadmap",
  7: "step-build",
  8: "step-integrate",
  9: "step-secure",
  10: "step-deploy",
};

// Phasen in Reihenfolge des ersten Auftretens, mit Index der ersten Karte
const phases = deliverySteps.reduce<{ key: string; label: string; first: number; count: number }[]>((acc, s, i) => {
  const last = acc[acc.length - 1];
  if (last && last.key === s.phase) last.count++;
  else acc.push({ key: s.phase, label: phaseLabel[s.phase], first: i, count: 1 });
  return acc;
}, []);
---

<div class="lock" data-lock>
<div class="slider" data-slider>
  <div class="slider__head">
    <!-- Stepper (Gründer, 2026-09-18: „smootheres Design, professionell, stepper line like“):
         vier Stationen auf einer Linie, Ziffer im Knoten, Phase und Schrittzahl daneben. -->
    <div class="slider__steps" role="tablist" aria-label="Phasen">
      {phases.map((p, i) => (
        <button class={`step step--${p.key}`} type="button" role="tab" aria-selected={i === 0 ? "true" : "false"} data-tab={p.first}>
          <span class="step__node" aria-hidden="true">{i + 1}</span>
          <span class="step__text">
            <span class="step__label">{p.label}</span>
            <span class="step__count">{p.count} {p.count === 1 ? "Schritt" : "Schritte"}</span>
          </span>
        </button>
      ))}
    </div>
    <div class="slider__arrows">
      <button class="slider__arrow" type="button" data-prev aria-label="Vorherige Schritte" disabled>
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M13 8H3M7 4L3 8l4 4"/></svg>
      </button>
      <button class="slider__arrow" type="button" data-next aria-label="Nächste Schritte">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
      </button>
    </div>
  </div>

  <ol class="slider__track" data-track tabindex="0" aria-label="Die zehn Schritte">
    {deliverySteps.map((s) => (
      <li class={`card card--${s.phase}`} data-card>
        <span class="card__icon"><Icon name={stepIcon[s.n]} size={30} /></span>
        <div class="card__meta">
          <span class="card__n">{String(s.n).padStart(2, "0")}</span>
          <span class={`tag tag--${s.phase}`}>{phaseLabel[s.phase]}</span>
        </div>
        <h3>{s.title}</h3>
        <p>{s.text}</p>
      </li>
    ))}
  </ol>

  <div class="slider__bar" aria-hidden="true"><span class="slider__fill" data-fill></span></div>
</div>
</div>

<script>
  const init = (root: HTMLElement) => {
    const lock = root.closest<HTMLElement>("[data-lock]");
    const track = root.querySelector<HTMLElement>("[data-track]");
    const cards = Array.from(root.querySelectorAll<HTMLElement>("[data-card]"));
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-tab]"));
    const prev = root.querySelector<HTMLButtonElement>("[data-prev]");
    const next = root.querySelector<HTMLButtonElement>("[data-next]");
    const fill = root.querySelector<HTMLElement>("[data-fill]");
    if (!track || cards.length === 0) return;

    const step = () => cards[0].offsetWidth + parseFloat(getComputedStyle(track).columnGap || "0");
    const maxX = () => track.scrollWidth - track.clientWidth;

    // Scroll-Lock: Desktop, keine Reduced Motion. Vertikaler Weg = 0.8 × horizontaler Weg.
    const mq = window.matchMedia("(min-width: 900px) and (prefers-reduced-motion: no-preference)");
    const RATIO = 0.8;
    let locked = false;
    let top = 0;
    let span = 1;
    const measure = () => {
      if (!lock || !locked) return;
      lock.style.minHeight = "";
      const h = root.offsetHeight;
      span = Math.max(1, Math.round(maxX() * RATIO));
      lock.style.minHeight = `${h + span}px`;
      // Angepinnt vertikal mittig im Viewport, aber nie unter die Nav (102px)
      root.style.top = `${Math.max(102, Math.round((window.innerHeight - h) / 2))}px`;
      let t = 0;
      for (let el: HTMLElement | null = lock; el; el = el.offsetParent as HTMLElement | null) t += el.offsetTop;
      top = t;
    };
    const applyLock = () => {
      const want = mq.matches && !!lock;
      if (want === locked) return;
      locked = want;
      root.toggleAttribute("data-locked", locked);
      if (!locked && lock) { lock.style.minHeight = ""; root.style.top = ""; }
      measure();
      onScroll();
    };
    // Lock: Ziel aus der Seitenposition, die Spur folgt weich (Lerp pro Frame).
    let targetX = 0, animating = false;
    const animate = () => {
      const diff = targetX - track.scrollLeft;
      if (Math.abs(diff) < 0.5) { track.scrollLeft = targetX; animating = false; return; }
      track.scrollLeft += diff * 0.18;
      requestAnimationFrame(animate);
    };
    const onPageScroll = () => {
      if (!locked) return;
      const p = Math.min(1, Math.max(0, (window.scrollY - top) / span));
      targetX = p * maxX();
      if (!animating) { animating = true; requestAnimationFrame(animate); }
    };
    // Ziel-Karte anfahren: im Lock über die Seitenposition, sonst über die Spur.
    const scrollToX = (x: number, behavior: ScrollBehavior = "smooth") => {
      if (locked) {
        const p = maxX() > 0 ? Math.min(1, Math.max(0, x / maxX())) : 0;
        window.scrollTo({ top: top + p * span, behavior });
      } else {
        track.scrollTo({ left: x, behavior });
      }
    };
    const goTo = (i: number) => scrollToX(cards[i].offsetLeft - track.offsetLeft);

    let raf = 0;
    const update = () => {
      raf = 0;
      const max = track.scrollWidth - track.clientWidth;
      const x = track.scrollLeft;
      if (fill) fill.style.transform = `scaleX(${max > 0 ? Math.min(1, Math.max(0, x / max)) : 1})`;
      if (prev) prev.disabled = x <= 2;
      if (next) next.disabled = x >= max - 2;
      // aktive Phase: Karte, die der linken Kante am nächsten ist
      let idx = 0;
      let best = Infinity;
      cards.forEach((c, i) => {
        const d = Math.abs(c.offsetLeft - track.offsetLeft - x);
        if (d < best) { best = d; idx = i; }
      });
      if (x >= max - 2) idx = cards.length - 1;
      let active = 0;
      tabs.forEach((t, i) => { if (idx >= Number(t.dataset.tab)) active = i; });
      tabs.forEach((t, i) => { t.setAttribute("aria-selected", i === active ? "true" : "false"); t.toggleAttribute("data-done", i < active); });
    };
    const onScroll = () => { if (!raf) raf = requestAnimationFrame(update); };

    track.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    prev?.addEventListener("click", () => scrollToX(track.scrollLeft - step()));
    next?.addEventListener("click", () => scrollToX(track.scrollLeft + step()));
    tabs.forEach((t) => t.addEventListener("click", () => goTo(Number(t.dataset.tab))));
    track.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") { e.preventDefault(); scrollToX(track.scrollLeft + step()); }
      if (e.key === "ArrowLeft") { e.preventDefault(); scrollToX(track.scrollLeft - step()); }
    });
    let rafPage = 0;
    window.addEventListener("scroll", () => { if (!rafPage) rafPage = requestAnimationFrame(() => { rafPage = 0; onPageScroll(); }); }, { passive: true });
    window.addEventListener("resize", () => { measure(); onPageScroll(); }, { passive: true });
    mq.addEventListener("change", applyLock);
    window.addEventListener("load", () => { measure(); onPageScroll(); }, { once: true });
    applyLock();
    update();
  };
  document.querySelectorAll<HTMLElement>("[data-slider]").forEach(init);
</script>

<style>
  .slider { display: grid; gap: 24px; }
  /* Scroll-Lock: der Wrapper bekommt vom Skript seine Höhe, der Slider bleibt stehen. */
  .slider[data-locked] {
    position: sticky;
    top: calc(74px + 28px);
  }
  .slider[data-locked] .slider__track {
    scroll-snap-type: none;
  }

  /* Kopf: Phasen-Tabs links, Pfeile rechts */
  .slider__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px 24px;
  }
  /* Stepper: Knoten auf einer durchgehenden Linie. Aktiv gefüllt, passiert umrandet,
     kommend gedämpft. Die Linie läuft hinter den Knoten von Station zu Station. */
  .slider__steps { display: flex; align-items: flex-start; flex: 1 1 520px; max-width: 760px; }
  .step {
    position: relative; flex: 1 1 0; min-width: 0;
    display: flex; align-items: center; gap: 12px;
    padding: 6px 28px 6px 0; margin: 0; border: 0; background: transparent; text-align: left;
    cursor: pointer; color: var(--fg-muted);
  }
  .step:last-child { flex: 0 0 auto; padding-right: 0; }
  .step::after {
    content: ""; position: absolute; top: 50%; left: 40px; right: 12px; height: 1px;
    background: var(--line); transform: translateY(-0.5px);
  }
  .step:last-child::after { display: none; }
  .step__node {
    flex: 0 0 auto; width: 30px; height: 30px; border-radius: 50%;
    display: inline-flex; align-items: center; justify-content: center;
    border: 1.5px solid var(--line-strong); background: var(--paper);
    font-family: var(--font-display); font-size: 0.8rem; font-weight: 600; color: var(--fg-muted);
    transition: background-color 0.25s, border-color 0.25s, color 0.25s;
  }
  .step__text { display: grid; gap: 1px; min-width: 0; }
  .step__label { font-family: var(--font-display); font-size: 0.92rem; font-weight: 600; letter-spacing: -0.005em; color: var(--fg-muted); white-space: nowrap; transition: color 0.2s; }
  .step__count { font-size: 0.76rem; color: var(--fg-muted); opacity: 0.8; white-space: nowrap; }
  .step:hover .step__label, .step:hover .step__node { color: var(--fg); }
  .step:hover .step__node { border-color: var(--fg); }
  .step[data-done] .step__node { border-color: var(--accent); color: var(--accent); }
  .step[data-done]::after { background: var(--accent); opacity: 0.45; }
  .step[aria-selected="true"] .step__node { background: var(--accent); border-color: var(--accent); color: #fff; }
  .step[aria-selected="true"] .step__label { color: var(--fg); }
  .step:focus-visible { outline: none; }
  .step:focus-visible .step__node { outline: 2px solid var(--accent); outline-offset: 3px; }
  @media (max-width: 599px) {
    .slider__steps { flex-basis: 100%; }
    .step { gap: 8px; padding-right: 16px; }
    .step::after { left: 32px; right: 6px; }
    .step__node { width: 26px; height: 26px; font-size: 0.72rem; }
    .step__label { font-size: 0.8rem; }
    .step__count { display: none; }
  }
  .slider__arrows { display: flex; gap: 8px; }
  .slider__arrow {
    width: 42px;
    height: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--paper);
    color: var(--fg);
    cursor: pointer;
    transition: border-color 0.2s, opacity 0.2s, transform 0.15s var(--ease-out);
  }
  .slider__arrow svg { width: 16px; height: 16px; }
  .slider__arrow:hover:not(:disabled) { border-color: var(--line-strong); }
  .slider__arrow:active:not(:disabled) { transform: scale(0.95); }
  .slider__arrow:disabled { opacity: 0.35; cursor: default; }

  /* Spur: bricht aus dem Container nach rechts aus, snappt je Karte */
  .slider__track {
    list-style: none;
    margin: 0;
    padding: 4px 0 8px;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(84vw, 400px);
    column-gap: 16px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 0;
    scrollbar-width: none;
    /* rechts bis zum Viewport-Rand laufen lassen */
    margin-right: calc(-1 * var(--gutter));
    padding-right: var(--gutter);
  }
  .slider__track::-webkit-scrollbar { display: none; }
  .slider__track:focus-visible { outline: 2px solid var(--accent); outline-offset: 6px; border-radius: var(--radius); }
  @media (min-width: 1296px) {
    .slider__track { margin-right: calc((100vw - var(--container)) / -2); padding-right: calc((100vw - var(--container)) / 2); }
  }

  .card {
    scroll-snap-align: start;
    display: grid;
    align-content: start;
    gap: 14px;
    padding: 30px 28px 32px;
    min-height: 300px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    transition: border-color 0.2s, transform 0.25s var(--ease-out), box-shadow 0.25s;
  }
  .card:hover { border-color: var(--line-strong); transform: translateY(-3px); box-shadow: 0 14px 34px rgba(21, 4, 43, 0.08); }
  .card--process { --accent: var(--process-text); }
  .card--design { --accent: var(--accent); }
  .card--build { --accent: var(--mauve); }
  .card--production { --accent: var(--production-text); }
  .card__icon { display: inline-flex; color: var(--accent); margin-bottom: 8px; }
  .card__icon :global(svg) { width: 34px; height: 34px; }
  .card__meta {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .card__n { font-weight: 600; color: var(--fg); }
  .card h3 { font-size: 1.3rem; line-height: 1.25; text-wrap: balance; }
  .card p { color: var(--fg-muted); font-size: 1rem; line-height: 1.55; }

  /* Fortschrittslinie */
  .slider__bar { height: 2px; background: var(--line); border-radius: 2px; overflow: hidden; }
  .slider__fill { display: block; height: 100%; width: 100%; background: var(--axis); transform-origin: left; transform: scaleX(0); transition: transform 0.15s linear; }

  @media (prefers-reduced-motion: reduce) {
    .slider__track { scroll-behavior: auto; }
    .card, .slider__fill { transition: none; }
    .card:hover { transform: none; }
  }
</style>
