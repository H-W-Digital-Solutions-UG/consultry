---
import { deliverySteps } from "../data/content";
const phaseLabel: Record<string, string> = {
  process: "Prozess",
  design: "Design",
  build: "Engineering",
  production: "Produktion",
};
---

<ol class="steps">
  {deliverySteps.map((s) => (
    <li class={`step step--${s.phase}`}>
      <div class="step__meta">
        <span class="step__n">{String(s.n).padStart(2, "0")}</span>
        <span class="step__phase">{phaseLabel[s.phase]}</span>
      </div>
      <h3>{s.title}</h3>
      <p>{s.text}</p>
    </li>
  ))}
</ol>

<style>
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  @media (min-width: 720px) { .steps { grid-template-columns: repeat(2, 1fr); } }
  .step {
    background: var(--paper);
    padding: 28px 26px 30px;
    display: grid;
    gap: 12px;
    align-content: start;
  }
  .step__meta {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .step__n {
    font-weight: 600;
    color: var(--fg);
  }
  .step__phase {
    padding: 4px 8px;
    border-radius: 999px;
    color: var(--fg-muted);
    background: var(--paper-2);
  }
  .step--process .step__phase { color: var(--process); background: var(--process-soft); }
  .step--design .step__phase { color: #6c62ff; background: rgba(108, 98, 255, 0.12); }
  .step--build .step__phase { color: #c2571b; background: rgba(255, 138, 61, 0.12); }
  .step--production .step__phase { color: var(--production); background: var(--production-soft); }
  .step p { color: var(--fg-muted); font-size: 0.98rem; }
</style>
