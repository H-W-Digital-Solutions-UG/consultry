---
import { deliverySteps } from "../data/content";
import Icon from "./Icon.astro";
import type { IconName } from "../icons/icons";

const phaseLabel: Record<string, string> = {
  process: "Prozess",
  design: "Design",
  build: "Engineering",
  production: "Produktion",
};

// Icon je Schrittnummer (Daten in content.ts bleiben unverändert)
const stepIcon: Record<number, IconName> = {
  1: "step-understand",
  2: "step-detect",
  3: "step-potential",
  4: "step-evaluate",
  5: "step-redesign",
  6: "step-roadmap",
  7: "step-build",
  8: "step-integrate",
  9: "step-secure",
  10: "step-deploy",
};
---

<ol class="steps">
  {deliverySteps.map((s) => (
    <li class={`step step--${s.phase}`}>
      <span class="step__icon"><Icon name={stepIcon[s.n]} size={28} /></span>
      <div class="step__meta">
        <span class="step__n">{String(s.n).padStart(2, "0")}</span>
        <span class={`tag tag--${s.phase}`}>{phaseLabel[s.phase]}</span>
      </div>
      <h3>{s.title}</h3>
      <p>{s.text}</p>
    </li>
  ))}
</ol>

<style>
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  @media (min-width: 720px) { .steps { grid-template-columns: repeat(2, 1fr); } }
  .step {
    background: var(--paper);
    padding: 28px 26px 30px;
    display: grid;
    gap: 12px;
    align-content: start;
  }
  /* Phasenfarbe für das Icon; --accent kann global überschrieben werden */
  .step--process { --accent: var(--process-text); }
  .step--design { --accent: var(--accent); }
  .step--build { --accent: var(--mauve); }
  .step--production { --accent: var(--production-text); }
  .step__icon {
    display: inline-flex;
    color: var(--accent, var(--process));
    margin-bottom: 4px;
  }
  .step__meta {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .step__n {
    font-weight: 600;
    color: var(--fg);
  }
  .step p { color: var(--fg-muted); font-size: 0.98rem; }
</style>
