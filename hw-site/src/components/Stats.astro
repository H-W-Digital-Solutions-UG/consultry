---
/**
 * Die Lage in Zahlen: vier Studienwerte als ruhige Kacheln (große Ziffer,
 * ein Satz, kleines Chart, Quelle) plus eine Zeile eigener Fakten.
 * Charts sind reines SVG/CSS; Ziffern zählen beim Einblenden hoch (nur
 * Desktop, nicht bei Reduced Motion). Quelle steht immer am Element.
 */
import { stats } from "../data/content";
const R = 26, C = 2 * Math.PI * R;
---

<div class="stats">
  <ul class="stats__grid">
    {stats.items.map((it) => (
      <li class="stat" data-reveal>
        <p class="stat__tie">{it.tie}</p>
        <p class="stat__value"><span class="stat__num" data-to={it.value}>{it.value}</span><span class="stat__unit">%</span></p>
        <p class="stat__label">{it.label}</p>
        <div class="stat__chart" aria-hidden="true">
          {it.chart === "stack" && (
            <div class="stack">
              <div class="stack__track">
                {it.series.map((sg) => <span class="stack__seg" style={`--w: ${sg.v}%`}></span>)}
              </div>
              <div class="stack__legend">
                {it.series.map((sg) => <span><i></i>{sg.v} % {sg.name}</span>)}
              </div>
            </div>
          )}
          {it.chart === "bars" && (
            <div class="bars">
              {it.series.map((sg) => (
                <div class="bars__row">
                  <span class="bars__name">{sg.name}</span>
                  <span class="bars__track"><span class="bars__fill" style={`--w: ${sg.v}%`}></span></span>
                  <span class="bars__v">{sg.v} %</span>
                </div>
              ))}
            </div>
          )}
          {it.chart === "ring" && (
            <svg class="ring" viewBox="0 0 64 64" width="64" height="64">
              <circle class="ring__track" cx="32" cy="32" r={R} />
              <circle class="ring__fill" cx="32" cy="32" r={R} style={`--c: ${C.toFixed(2)}; --v: ${it.series[0].v}`} />
            </svg>
          )}
        </div>
        <p class="stat__source">Quelle: {it.source}</p>
      </li>
    ))}
  </ul>
  <ul class="facts">
    {stats.facts.map((f) => (
      <li class="fact">
        <span class="fact__value">{f.value}{f.unit && <span class="fact__unit"> {f.unit}</span>}</span>
        <span class="fact__label">{f.label}</span>
      </li>
    ))}
  </ul>
</div>

<script>
  const els = Array.from(document.querySelectorAll<HTMLElement>("[data-reveal]"));
  const anim =
    "IntersectionObserver" in window &&
    !window.matchMedia("(prefers-reduced-motion: reduce)").matches &&
    window.matchMedia("(min-width: 900px)").matches;
  const ease = (t: number) => 1 - Math.pow(1 - t, 3);
  const count = (el: HTMLElement) => {
    const to = Number(el.dataset.to || 0);
    const t0 = performance.now();
    const step = (now: number) => {
      const t = Math.min(1, (now - t0) / 1100);
      el.textContent = String(Math.round(to * ease(t)));
      if (t < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };
  if (anim) {
    els.forEach((el) => el.classList.add("will-reveal"));
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          const el = e.target as HTMLElement;
          el.classList.add("is-in");
          el.querySelectorAll<HTMLElement>(".stat__num").forEach(count);
          io.unobserve(el);
        });
      },
      { rootMargin: "0px 0px -12% 0px" },
    );
    els.forEach((el) => io.observe(el));
  }
</script>

<style>
  .stats { display: grid; gap: 28px; }
  .stats__grid {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: 1px;
    background: var(--line-on-ink); border: 1px solid var(--line-on-ink); border-radius: var(--radius-lg); overflow: hidden;
  }
  @media (min-width: 720px) { .stats__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .stats__grid { grid-template-columns: repeat(4, 1fr); } }
  .stat {
    background: var(--ink);
    padding: 26px 24px 24px;
    display: grid; gap: 10px; align-content: start;
    transition: background-color 0.2s;
  }
  .stat:hover { background: var(--ink-2); }
  .stat__tie { margin: 0; font-family: var(--font-display); font-size: 0.85rem; font-weight: 500; color: var(--accent-on-ink); min-height: 2.4em; }
  .stat__value {
    margin: 4px 0 0;
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(3rem, 5vw, 4.4rem); line-height: 0.95; letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
    color: var(--fg-on-ink);
  }
  .stat__unit { font-size: 0.42em; font-weight: 600; margin-left: 4px; color: var(--fg-on-ink-muted); letter-spacing: -0.01em; }
  .stat__label { margin: 0; color: var(--fg-on-ink-muted); font-size: 0.95rem; line-height: 1.5; min-height: 4.4em; }
  .stat__chart { margin-top: 6px; min-height: 64px; display: flex; align-items: flex-end; }
  .stat__source { margin: 6px 0 0; font-family: var(--font-mono); font-size: 0.68rem; letter-spacing: 0.02em; color: var(--fg-on-ink-muted); opacity: 0.75; }

  /* Balken */
  .bars { width: 100%; display: grid; gap: 10px; }
  .bars__row { display: grid; grid-template-columns: 1fr auto; gap: 4px 10px; align-items: center; font-size: 0.78rem; color: var(--fg-on-ink-muted); }
  .bars__name { grid-column: 1; }
  .bars__v { grid-column: 2; font-variant-numeric: tabular-nums; color: var(--fg-on-ink); }
  .bars__track { grid-column: 1 / -1; height: 6px; border-radius: 3px; background: rgba(245, 241, 251, 0.1); overflow: hidden; }
  .bars__fill { display: block; height: 100%; width: var(--w); border-radius: 3px; background: var(--accent-on-ink); }
  /* Gestapelter Balken */
  .stack { width: 100%; display: grid; gap: 10px; }
  .stack__track { display: flex; gap: 2px; height: 10px; border-radius: 5px; overflow: hidden; background: rgba(245, 241, 251, 0.1); }
  .stack__seg { display: block; width: var(--w); height: 100%; background: var(--accent-on-ink); }
  .stack__seg + .stack__seg { background: rgba(195, 165, 255, 0.4); }
  .stack__legend { display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: 0.78rem; color: var(--fg-on-ink-muted); }
  .stack__legend i { display: inline-block; width: 8px; height: 8px; border-radius: 2px; background: var(--accent-on-ink); margin-right: 6px; vertical-align: middle; }
  .stack__legend span + span i { background: rgba(195, 165, 255, 0.4); }
  /* Ring */
  .ring { transform: rotate(-90deg); }
  .ring__track { fill: none; stroke: rgba(245, 241, 251, 0.1); stroke-width: 6; }
  .ring__fill { fill: none; stroke: var(--accent-on-ink); stroke-width: 6; stroke-linecap: round; stroke-dasharray: var(--c); stroke-dashoffset: calc(var(--c) * (1 - var(--v) / 100)); }

  /* Einblenden mit Chart-Aufbau (nur wenn das Skript es freigibt) */
  .stat.will-reveal { opacity: 0; transform: translateY(10px); transition: opacity 0.6s var(--ease-out), transform 0.6s var(--ease-out); }
  .stat.will-reveal :is(.bars__fill, .stack__seg) { width: 0; transition: width 1.1s var(--ease-out) 0.25s; }
  .stat.will-reveal .ring__fill { stroke-dashoffset: var(--c); transition: stroke-dashoffset 1.1s var(--ease-out) 0.25s; }
  .stat.will-reveal.is-in { opacity: 1; transform: none; }
  .stat.will-reveal.is-in :is(.bars__fill) { width: var(--w); }
  .stat.will-reveal.is-in .stack__seg { width: var(--w); }
  .stat.will-reveal.is-in .ring__fill { stroke-dashoffset: calc(var(--c) * (1 - var(--v) / 100)); }

  /* Eigene Fakten */
  .facts { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px 32px; grid-template-columns: repeat(2, 1fr); }
  @media (min-width: 720px) { .facts { grid-template-columns: repeat(4, 1fr); } }
  .fact { display: grid; gap: 4px; padding-top: 14px; border-top: 1px solid var(--line-on-ink); }
  .fact__value { font-family: var(--font-display); font-weight: 700; font-size: 1.6rem; letter-spacing: -0.03em; color: var(--fg-on-ink); font-variant-numeric: tabular-nums; }
  .fact__unit { font-size: 0.6em; font-weight: 600; color: var(--fg-on-ink-muted); }
  .fact__label { font-size: 0.88rem; color: var(--fg-on-ink-muted); }
</style>
