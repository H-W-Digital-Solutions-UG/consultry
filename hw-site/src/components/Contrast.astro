---
import { contrast } from "../data/content";
import Icon from "./Icon.astro";
---

<div class="contrast">
  <div class="contrast__col contrast__col--classic">
    <p class="eyebrow">Klassische Beratung</p>
    <ul>
      {contrast.classic.map((c) => <li><span class="mark mark--classic" aria-hidden="true"></span>{c}</li>)}
    </ul>
    <p class="contrast__end"><Icon name="step-potential" size={16} />{contrast.classicEnd}</p>
  </div>
  <div class="contrast__col contrast__col--hw">
    <p class="eyebrow">H&amp;W</p>
    <ul>
      {contrast.hw.map((c) => <li><span class="mark mark--hw" aria-hidden="true"><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 6.5L5 9L9.5 3.5"/></svg></span>{c}</li>)}
    </ul>
    <p class="contrast__end"><Icon name="step-deploy" size={16} />{contrast.hwEnd}</p>
  </div>
</div>

<style>
  .contrast {
    position: relative;
    display: grid;
    gap: 16px;
    isolation: isolate;
  }
  /* Dezente Farbfläche hinter den Karten, damit das Glas etwas zu brechen hat:
     Lavendel links (Prozess), Magenta rechts (Produktion), stark gedämpft. */
  .contrast::before {
    content: "";
    position: absolute;
    inset: 10% -4% 10% -4%;
    border-radius: 999px;
    background:
      radial-gradient(60% 70% at 18% 40%, color-mix(in oklab, var(--process) 22%, transparent), transparent 70%),
      radial-gradient(55% 70% at 84% 60%, color-mix(in oklab, var(--production) 18%, transparent), transparent 70%);
    filter: blur(40px);
    z-index: -1;
    pointer-events: none;
  }
  @media (min-width: 720px) { .contrast { grid-template-columns: 1fr 1fr; } }
  /* Glas-Karten: transluzent mit Blur, klare 1px-Kontur, weicher Schatten */
  .contrast__col {
    position: relative;
    padding: 28px;
    border-radius: var(--radius-lg);
    border: 1px solid rgba(245, 241, 251, 0.14);
    background: linear-gradient(160deg, rgba(245, 241, 251, 0.07), rgba(245, 241, 251, 0.03));
    -webkit-backdrop-filter: blur(18px) saturate(1.2);
    backdrop-filter: blur(18px) saturate(1.2);
    box-shadow:
      0 24px 60px rgba(8, 0, 22, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }
  .contrast__col::before {
    content: "";
    position: absolute;
    inset: 0 auto auto 0;
    width: 100%;
    height: 1px;
    border-radius: inherit;
    background: linear-gradient(90deg, transparent, rgba(245, 241, 251, 0.22) 50%, transparent);
  }
  .contrast__col--hw {
    border-color: rgba(195, 165, 255, 0.45);
    background: linear-gradient(160deg, rgba(195, 165, 255, 0.12), rgba(211, 108, 240, 0.05));
    box-shadow:
      0 24px 60px rgba(8, 0, 22, 0.5),
      0 0 0 1px rgba(195, 165, 255, 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 0.12);
  }
  .contrast__col--hw::before {
    background: linear-gradient(90deg, transparent, rgba(195, 165, 255, 0.7) 30%, rgba(211, 108, 240, 0.7) 70%, transparent);
  }
  ul {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: grid;
    gap: 10px;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  li { display: flex; gap: 12px; align-items: center; }
  .mark {
    flex: none; display: grid; place-items: center; width: 20px; height: 20px; border-radius: 50%;
  }
  .mark--classic { border: 1px solid var(--line-on-ink-strong, rgba(245,241,251,.25)); }
  .mark--classic::after { content: ""; width: 6px; height: 1.5px; background: var(--fg-on-ink-muted); border-radius: 1px; }
  .mark--hw { color: var(--ink); background: var(--accent-on-ink); }
  .mark--hw svg { width: 12px; height: 12px; }
  .contrast__col--classic li:last-child { color: var(--fg-on-ink-muted); }
  .contrast__end { display: flex; align-items: center; gap: 8px; }
  .contrast__end :global(svg) { width: 16px; height: 16px; opacity: 0.8; }
  .contrast__end {
    margin-top: 22px;
    padding-top: 16px;
    border-top: 1px solid var(--line-on-ink);
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: -0.005em;
    color: var(--fg-on-ink-muted);
  }
  /* Produktives System = Ende der Achse: Gold als sparsamer Akzent */
  .contrast__col--hw .contrast__end { color: var(--production); }
</style>
