---
/**
 * Proof-Szene „Wer bei uns baut“ (Gründer, 2026-09-18: „muss richtig hitten und
 * professionell aussehen; kein Body Leasing, sondern seasoned experts, die auf Sie
 * eingehen; Consulting = Expertise und Wissen gepaart mit Kommunikation und
 * Hospitality“). Links die Senior-Zusage (Muster durchgestrichen, Hook, ein Satz,
 * CTA). Rechts ein Freisteller (Gründer: „schwebend auf hellem Background, kein
 * eigener deckender Background; hohe Qualität, professionell, minimalistisch“):
 * ein Besprechungstisch, Stühle nah beieinander, Kaffee, Notizbuch, matt in der
 * Lila-Familie, ohne Personen, mit weichem Schlagschatten auf dem Papier. Darunter
 * die Zertifikate des Gründerteams, klein und gedämpft.
 */
import { Image } from "astro:assets";
import { expertise, certifications } from "../data/content";
import scene from "../assets/expertise.webp";

const badgeFiles = import.meta.glob<{ default: ImageMetadata }>("../assets/certs/*.png", { eager: true });
const badge = (file: string) => badgeFiles[`../assets/certs/${file}`]?.default;
---

<section class="section section--paper-2 xp" aria-labelledby="xp-heading">
  <div class="container xp__grid">
    <div class="xp__copy">
      <p class="eyebrow">{expertise.eyebrow}</p>
      <p class="xp__quote"><span>„{expertise.quote}“</span></p>
      <h2 class="xp__h" id="xp-heading">{expertise.heading}</h2>
      <p class="xp__text">{expertise.text}</p>
      <div class="xp__actions">
        <a class="btn btn--primary" href={expertise.cta.href}>
          {expertise.cta.label}
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
        </a>
      </div>
    </div>
    <div class="xp__proof">
      <figure class="xp__scene">
        <Image class="xp__img" src={scene} alt="" widths={[640, 960, 1440]} sizes="(min-width: 900px) 46vw, 100vw" loading="lazy" format="webp" />
        <figcaption class="xp__caption">{expertise.caption}</figcaption>
      </figure>
      <div class="xp__certs">
        <ul class="xp__badges" aria-label="Zertifizierungen im Gründerteam">
          {certifications.map((c) => {
            const img = badge(c.file);
            return (
              <li>
                {img && <Image src={img} alt={`${c.name} (${c.issuer})`} title={`${c.name}, ${c.issuer}`} width={40} densities={[1, 2]} loading="lazy" />}
              </li>
            );
          })}
        </ul>
        <p class="xp__certs-label">
          <strong>{certifications.length}</strong> {expertise.certsLabel}
          <a class="xp__link" href={expertise.secondary.href}>{expertise.secondary.label}<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .xp { padding-block: clamp(56px, 8vh, 96px); }
  .xp__grid { display: grid; gap: 32px; }
  @media (min-width: 900px) { .xp__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: 72px; align-items: center; } }
  .xp__quote {
    margin: 18px 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 1.6vw, 1.35rem);
    font-weight: 500; letter-spacing: -0.02em; line-height: 1.2;
    color: var(--fg-muted);
  }
  .xp__quote span { text-decoration: line-through; text-decoration-thickness: 2px; text-decoration-color: var(--accent); text-decoration-skip-ink: none; }
  .xp__h { margin-top: 12px; max-width: 16ch; font-size: clamp(2rem, 3.6vw, 3.2rem); }
  .xp__text { margin: 18px 0 0; color: var(--fg-muted); max-width: 44ch; font-size: clamp(1.05rem, 1.35vw, 1.2rem); text-wrap: pretty; }
  .xp__actions { margin-top: 28px; display: flex; flex-wrap: wrap; gap: 12px; }

  .xp__proof { display: grid; gap: 20px; }
  /* Freisteller: kein Kasten, kein eigener Hintergrund. Das Objekt schwebt auf dem
     Papier, ein weicher Schlagschatten trägt es; die Bildunterschrift steht darunter. */
  .xp__scene { margin: 0; display: grid; gap: 14px; justify-items: center; }
  .xp__img {
    display: block; width: 100%; max-width: 560px; height: auto;
    filter: drop-shadow(0 28px 36px rgba(21, 4, 43, 0.22)) drop-shadow(0 4px 8px rgba(21, 4, 43, 0.08));
  }
  .xp__caption {
    font-family: var(--font-display); font-size: 0.95rem; font-weight: 500; letter-spacing: -0.01em;
    color: var(--fg-muted);
  }
  .xp__certs { display: grid; gap: 10px; padding-top: 16px; border-top: 1px solid var(--line); }
  .xp__badges { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .xp__badges img { display: block; width: 36px; height: auto; filter: saturate(0.2); opacity: 0.8; transition: filter 0.25s, opacity 0.25s; }
  .xp__badges li:hover img { filter: none; opacity: 1; }
  .xp__certs-label { margin: 0; font-size: 0.9rem; color: var(--fg-muted); display: flex; flex-wrap: wrap; gap: 4px 14px; align-items: baseline; }
  .xp__certs-label strong { font-family: var(--font-display); font-weight: 700; color: var(--fg); font-size: 1.05rem; }
  .xp__link { display: inline-flex; align-items: center; gap: 6px; font-family: var(--font-display); font-size: 0.86rem; font-weight: 600; color: var(--accent); text-decoration: none; }
  .xp__link svg { width: 13px; height: 13px; transition: transform 0.2s var(--ease-out); }
  .xp__link:hover svg { transform: translateX(3px); }
  @media (max-width: 899px) {
    .xp__img { max-width: 420px; }
    .xp__badges img { width: 32px; }
  }
</style>