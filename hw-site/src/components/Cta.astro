---
import { company } from "../data/company";
interface Props { heading?: string; text?: string; }
const {
  heading = "Bringen Sie einen Ablauf mit. Wir sagen Ihnen, ob AI dort etwas bringt.",
  text = "30 Minuten, kostenlos, ohne Folien. Wenn AI nichts bringt, sagen wir das auch.",
} = Astro.props;
---

<section class="section section--ink cta">
  <div class="container cta__inner">
    <div>
      <p class="eyebrow">Kostenloses Erstgespräch</p>
      <h2>{heading}</h2>
      <p class="lede">{text}</p>
    </div>
    <div class="cta__actions">
      <a class="btn btn--primary" href="/kontakt">Kostenloses Erstgespräch vereinbaren</a>
      <a class="btn btn--ghost" href={`mailto:${company.email}`}>{company.email}</a>
    </div>
  </div>
</section>

<style>
  .cta { border-top: 1px solid var(--line-on-ink); }
  .cta__inner {
    display: grid;
    gap: 32px;
    align-items: end;
  }
  @media (min-width: 900px) { .cta__inner { grid-template-columns: 1.4fr 1fr; } }
  .cta h2 { margin-top: 16px; }
  .cta .lede { margin-top: 16px; }
  .cta__actions { display: flex; flex-wrap: wrap; gap: 12px; }
  @media (min-width: 900px) { .cta__actions { justify-content: flex-end; } }
</style>
