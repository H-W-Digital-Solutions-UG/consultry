---
/**
 * Delivery Chain – vertikale Timeline.
 * Alle zwölf Schritte stehen untereinander; mit JS wird die Sektion gepinnt,
 * die Linie füllt sich beim Scrollen von oben nach unten, der aktive Schritt
 * wird hervorgehoben und rechts groß ausgelesen. Nur transform/opacity, keine
 * Bibliothek, kein Glow (DESIGN.md, Motion-Regeln). Ohne JS, bei
 * prefers-reduced-motion, Save-Data oder 2G: statische Liste, alle Schritte
 * aktiv, kein Pin. Slot "heading" nimmt Eyebrow und Überschrift der Seite auf.
 */
import { chain, chainTexts } from "../data/content";
import Icon from "./Icon.astro";
import type { IconName } from "../icons/icons";
const n = chain.length;
// Icon und Phase je Glied der Chain (Reihenfolge wie in content.ts)
const meta: { icon: IconName; phase: string }[] = [
  { icon: "step-understand", phase: "Prozess" },
  { icon: "cap-process-analysis", phase: "Prozess" },
  { icon: "step-detect", phase: "Prozess" },
  { icon: "step-redesign", phase: "Design" },
  { icon: "step-roadmap", phase: "Design" },
  { icon: "cap-model-engineering", phase: "Engineering" },
  { icon: "cap-software-engineering", phase: "Engineering" },
  { icon: "step-integrate", phase: "Engineering" },
  { icon: "step-deploy", phase: "Produktion" },
  { icon: "step-secure", phase: "Produktion" },
  { icon: "cap-ai-enablement", phase: "Produktion" },
  { icon: "chain-measure", phase: "Produktion" },
];
// Phasen-Gruppen (zusammenhängende Bereiche) für die aufklappbare Liste
const groups = meta.reduce<{ phase: string; from: number; to: number }[]>((acc, m, i) => {
  const last = acc[acc.length - 1];
  if (last && last.phase === m.phase) last.to = i; else acc.push({ phase: m.phase, from: i, to: i });
  return acc;
}, []);
const pad = (i: number) => String(i + 1).padStart(2, "0");
// Passender CTA je Phase (Karte rechts)
const phaseCta: Record<string, { label: string; href: string }> = {
  Prozess: { label: "Ihren Ablauf im Erstgespräch durchgehen", href: "/kontakt" },
  Design: { label: "So denken wir Prozesse neu", href: "/vorgehen" },
  Engineering: { label: "Was wir selbst bauen", href: "/leistungen" },
  Produktion: { label: "Kostenloses Erstgespräch vereinbaren", href: "/kontakt" },
};
---

<div class="chain" data-chain style={`--n:${n}`}>
  <div class="chain__track">
    <div class="chain__stage">
      <div class="chain__head"><slot name="heading" /></div>

      <ol class="chain__rail" aria-label="Zwölf Schritte von der Analyse bis zur laufenden Lösung">
        {groups.map((g, gi) => (
          <li class="chain__group" style={`--g:${gi}; --from:${g.from}; --to:${g.to}`} data-open={gi === 0 ? "" : undefined}>
            <button type="button" class="chain__group-head" data-goto={g.from} aria-expanded={gi === 0 ? "true" : "false"}>
              <span class="chain__group-n" aria-hidden="true">{gi + 1}</span>
              <span class="chain__group-text">
                <span class="chain__group-name">{g.phase}</span>
                <span class="chain__group-range">Schritte {pad(g.from)}–{pad(g.to)}</span>
              </span>
            </button>
            <ol class="chain__steps">
              {chain.slice(g.from, g.to + 1).map((step, k) => { const i = g.from + k; return (
                <li class="chain__item" style={`--i:${i}`} data-phase={meta[i].phase} data-text={chainTexts[i]}>
                  <button type="button" class="chain__step" data-goto={i}>
                    <span class="chain__dot" aria-hidden="true"></span>
                    <span class="chain__text">
                      <span class="chain__idx" aria-hidden="true">{pad(i)}</span>
                      <span class="chain__label">{step}</span>
                      <span class="chain__desc">{chainTexts[i]}</span>
                    </span>
                  </button>
                </li>
              ); })}
            </ol>
          </li>
        ))}
      </ol>

      <!-- Readout als Kartenstapel: alle Glieder liegen übereinander, das Skript
           schiebt sie mit dem Scroll durch (aktive vorn, Nachbarn ragen heraus). -->
      <div class="chain__readout" data-stack>
        {meta.map((m, i) => (
          <article class="chain__card" data-card={i} aria-hidden={i !== 0 ? "true" : undefined}>
            <img class="chain__card-art" src={`/images/steps/step-${pad(i)}.webp`} alt="" width="320" height="320" loading="lazy" decoding="async" />
            <span class="chain__readout-top">
              <span class="chain__readout-n">{pad(i)}</span>
              <span class="chain__readout-of">/ {String(n).padStart(2, "0")}</span>
            </span>
            <span class="chain__readout-phase">{m.phase}</span>
            <span class="chain__readout-label">{chain[i]}</span>
            <span class="chain__readout-text">{chainTexts[i]}</span>
            <a class="chain__card-cta" href={phaseCta[m.phase].href} tabindex={i !== 0 ? -1 : undefined}>
              {phaseCta[m.phase].label}
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
            </a>
          </article>
        ))}
      </div>
    </div>
  </div>
</div>

<script>
  const clamp = (v: number) => Math.min(1, Math.max(0, v));
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
  const net = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
  // Auf Phones (unter 900px) keine Szene: statische Liste mit Kurztexten, kein Pin, kein Stapel.
  const small = window.matchMedia("(max-width: 899px)");
  const blocked = () => small.matches || reduce.matches || !!net?.saveData || /(^|-)2g$/.test(net?.effectiveType ?? "");

  function mount(root: HTMLElement) {
    if (blocked()) return () => {};
    const track = root.querySelector<HTMLElement>(".chain__track")!;
    const stage = root.querySelector<HTMLElement>(".chain__stage")!;
    const items = Array.from(root.querySelectorAll<HTMLElement>(".chain__item"));
    const groupEls = Array.from(root.querySelectorAll<HTMLElement>(".chain__group"));
    const steps = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-goto]"));
    const cards = Array.from(root.querySelectorAll<HTMLElement>("[data-card]"));
    const mobile = window.matchMedia("(max-width: 899px)");
    // Kartenstapel: Zielposition aus dem Scroll, Ist-Position folgt weich (Lerp pro Frame).
    // cur startet unterhalb des Ziels: Beim ersten Sichtbarwerden läuft der
    // Stapel von unten ein (Einlauf-Animation ohne eigene Keyframes).
    let target = 0, cur = -1.4, animating = false;
    const paint = () => {
      const shift = mobile.matches ? 64 : 112;
      cards.forEach((c, i) => {
        const d = i - cur;
        const ad = Math.abs(d);
        if (ad > 1.6) { c.style.visibility = "hidden"; return; }
        c.style.visibility = "visible";
        // Listen-Gefühl: einlaufende Karte kippt leicht nach hinten (unten),
        // auslaufende nach vorn (oben); Nachbarn werden etwas unscharf.
        const tilt = (-d * 7).toFixed(2);
        const blur = Math.max(0, ad - 0.5) * 2.5;
        c.style.transform = `perspective(1400px) translate3d(0, ${(d * shift).toFixed(2)}px, ${(-ad * 40).toFixed(1)}px) rotateX(${tilt}deg) scale(${(1 - Math.min(ad, 1) * 0.06).toFixed(3)})`;
        c.style.opacity = String((ad < 0.5 ? 1 : Math.max(0, 1 - (ad - 0.5) * 1.4)).toFixed(3));
        c.style.filter = blur > 0.05 ? `blur(${blur.toFixed(2)}px)` : "";
        c.style.zIndex = String(100 - Math.round(ad * 10));
        c.classList.toggle("is-front", ad < 0.5);
      });
    };
    const animate = () => {
      const diff = target - cur;
      if (Math.abs(diff) < 0.002) { cur = target; paint(); animating = false; return; }
      cur += diff * 0.12;
      paint();
      requestAnimationFrame(animate);
    };
    const setTarget = (v: number) => { target = v; if (!animating) { animating = true; requestAnimationFrame(animate); } };
    const n = items.length;
    let top = 0, span = 1, ticking = false, active = -1;
    root.dataset.scene = "on";

    const measure = () => {
      top = track.getBoundingClientRect().top + window.scrollY;
      span = Math.max(1, track.offsetHeight - stage.offsetHeight);
    };
    const update = () => {
      ticking = false;
      const p = clamp((window.scrollY - top) / span);
      root.style.setProperty("--p", p.toFixed(4));
      // Kartenstapel: kontinuierlicher Index t; ein leichtes Smoothstep um die
      // Ganzzahlen lässt die Karten kurz rasten, der Lerp glättet den Rest.
      const t = p * (n - 1);
      const base = Math.floor(t);
      const e = clamp((t - base - 0.15) / 0.7);
      setTarget(base + e * e * (3 - 2 * e));
      const idx = Math.round(t);
      if (idx !== active) {
        active = idx;
        items.forEach((el, i) => {
          el.toggleAttribute("data-active", i === idx);
          el.toggleAttribute("data-passed", i < idx);
        });
        cards.forEach((c, i) => {
          const on = i === idx;
          if (on) c.removeAttribute("aria-hidden"); else c.setAttribute("aria-hidden", "true");
          const a = c.querySelector<HTMLAnchorElement>(".chain__card-cta");
          if (a) { if (on) a.removeAttribute("tabindex"); else a.tabIndex = -1; }
        });
        groupEls.forEach((g) => {
          const from = Number(g.style.getPropertyValue("--from")), to = Number(g.style.getPropertyValue("--to"));
          const open = idx >= from && idx <= to;
          g.toggleAttribute("data-open", open);
          g.toggleAttribute("data-passed", idx > to);
          g.querySelector(".chain__group-head")?.setAttribute("aria-expanded", String(open));
        });
      }
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
    const onResize = () => { measure(); onScroll(); };
    const onJump = (e: Event) => {
      const i = Number((e.currentTarget as HTMLElement).dataset.goto);
      window.scrollTo({ top: top + (span * i) / (n - 1), behavior: "smooth" });
    };
    steps.forEach((b) => b.addEventListener("click", onJump));

    let listening = false;
    const io = new IntersectionObserver(([e]) => {
      if (e.isIntersecting && !listening) { listening = true; window.addEventListener("scroll", onScroll, { passive: true }); onScroll(); }
      else if (!e.isIntersecting && listening) { listening = false; window.removeEventListener("scroll", onScroll); }
    }, { rootMargin: "200px 0px" });

    measure(); update(); io.observe(track);
    window.addEventListener("resize", onResize);
    document.fonts?.ready.then(onResize);
    // Layout-Änderungen oberhalb (z. B. der Hero-Track) verschieben den Pin-Bereich: neu messen
    const ro = new ResizeObserver(onResize);
    ro.observe(document.documentElement);
    return () => { io.disconnect(); ro.disconnect(); window.removeEventListener("resize", onResize); window.removeEventListener("scroll", onScroll); steps.forEach((b) => b.removeEventListener("click", onJump)); };
  }

  const cleanups = Array.from(document.querySelectorAll<HTMLElement>("[data-chain]")).map(mount);
  // Vorwärtskompatibel mit ClientRouter; heute volle Seitenladungen.
  document.addEventListener("astro:before-swap", () => cleanups.forEach((fn) => fn()), { once: true });
</script>

<style>
  .chain { --p: 1; --nav-h: 74px; --node: 40px; --step-node: 12px; --dot-pad: 9px; --row: 38px; }
  @media (max-width: 859px) { .chain { --nav-h: 65px; --node: 34px; --step-node: 10px; --dot-pad: 8px; --row: 34px; } }

  /* Statischer Zustand (ohne JS / reduced motion): normale Liste, alles aktiv */
  .chain__stage { display: grid; gap: 28px; }
  .chain__readout { display: none; }
  .chain:not([data-scene="on"]) .chain__steps > li { max-height: none; opacity: 1; }
  /* Kurztext je Schritt: nur im statischen Zustand (Phone, Reduced Motion, ohne JS) */
  .chain__desc { display: none; }
  .chain:not([data-scene="on"]) .chain__desc { display: block; margin-top: 4px; font-size: 0.92rem; line-height: 1.5; color: var(--fg-on-ink-muted); text-wrap: pretty; }
  .chain:not([data-scene="on"]) .chain__text { display: grid; gap: 0; grid-template-columns: auto 1fr; column-gap: 10px; align-items: baseline; }
  .chain:not([data-scene="on"]) .chain__desc { grid-column: 2; }
  .chain:not([data-scene="on"]) .chain__step { align-items: start; padding: 8px 0; }
  .chain:not([data-scene="on"]) .chain__dot { margin-top: 5px; }
  .chain:not([data-scene="on"]) .chain__steps > li .chain__step { min-height: 0; }
  .chain:not([data-scene="on"]) .chain__item::before, .chain:not([data-scene="on"]) .chain__item::after { display: none; }
  .chain:not([data-scene="on"]) .chain__group { padding-bottom: 14px; }
  .chain:not([data-scene="on"]) .chain__group-n { background: var(--ink-2); }
  .chain:not([data-scene="on"]) .chain__group::after { display: none; }

  .chain__rail, .chain__steps { list-style: none; margin: 0; padding: 0; display: grid; }
  .chain__group { position: relative; padding-bottom: 6px; }
  .chain__group-head {
    display: flex; align-items: center; gap: 14px; width: 100%; padding: 6px 0;
    background: transparent; border: 0; color: inherit; text-align: left; cursor: pointer; font: inherit;
  }
  .chain__group-head:hover .chain__group-name { color: var(--fg-on-ink); }
  .chain__group-n {
    flex: none; display: grid; place-items: center; width: var(--node); height: var(--node); border-radius: 50%;
    font-family: var(--font-display); font-weight: 300; font-size: 1rem; color: var(--accent-on-ink);
    background: var(--ink-2); border: 1px solid var(--line-on-ink-strong, rgba(245,241,251,.25));
    position: relative; z-index: 1; transition: background-color 0.24s, border-color 0.24s, color 0.24s;
  }
  .chain__group-text { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .chain__group-name { font-family: var(--font-display); font-weight: 600; font-size: 1.12rem; letter-spacing: -0.015em; color: var(--fg-on-ink); }
  .chain__group-range { font-family: var(--font-display); font-weight: 300; font-size: 0.8rem; letter-spacing: 0.04em; color: var(--fg-on-ink-muted); }
  /* Verbindungslinie zwischen den Phasen-Knoten (Basis + Füllung bis zum letzten Schritt der Gruppe) */
  .chain__group:not(:last-child)::before, .chain__group:not(:last-child)::after {
    content: ""; position: absolute; left: calc(var(--node) / 2 - 1px); top: calc(6px + var(--node)); bottom: -6px; width: 2px; border-radius: 2px;
  }
  .chain__group::before { background: var(--line-on-ink-strong, rgba(245, 241, 251, 0.18)); }
  .chain__group::after {
    --gseg: clamp(0, var(--p) * (var(--n) - 1) - var(--to), 1);
    background: var(--accent-on-ink); transform-origin: center top; transform: scaleY(var(--gseg)); transition: transform 0.16s linear;
  }
  /* Schritte: nur in der offenen Phase sichtbar */
  .chain__steps { padding-left: calc(var(--node) + 14px); }
  .chain__steps > li { overflow: hidden; max-height: 0; opacity: 0; transition: max-height 0.3s var(--ease-out), opacity 0.25s var(--ease-out); }
  .chain__group[data-open] .chain__steps > li { max-height: var(--row); opacity: 1; }
  .chain__steps > li .chain__step { min-height: var(--row); }
  .chain__group[data-open] .chain__group-n { background: var(--accent-on-ink); color: var(--ink); border-color: var(--accent-on-ink); }
  .chain__group[data-passed] .chain__group-n { border-color: var(--accent-on-ink); }
  .chain[data-scene="on"] .chain__group:not([data-open]):not([data-passed]) .chain__group-name { color: var(--fg-on-ink-muted); }
  .chain__item {
    --c0: color-mix(in oklab, var(--process) calc(100% - var(--i) / (var(--n) - 1) * 100%), var(--production));
    --c1: color-mix(in oklab, var(--process) calc(100% - (var(--i) + 1) / (var(--n) - 1) * 100%), var(--production));
    --seg: clamp(0, var(--p) * (var(--n) - 1) - var(--i), 1);
    position: relative;
  }
  .chain__step {
    display: flex; align-items: center; gap: 16px; width: 100%; padding: 4px 0;
    background: transparent; border: 0; color: inherit; text-align: left; cursor: pointer; font: inherit;
  }
  /* Vertikale Linie vom eigenen Node bis zum nächsten – Basis und Füllung */
  .chain__item:not(:last-child)::before,
  .chain__item:not(:last-child)::after {
    content: ""; position: absolute; left: calc(var(--dot-pad) + var(--step-node) / 2 - 1px); top: calc(var(--row) / 2 + var(--step-node) / 2); bottom: calc(var(--step-node) / 2 - var(--row) / 2); width: 2px; border-radius: 2px;
  }
  .chain__item::before { background: var(--line-on-ink-strong, rgba(245, 241, 251, 0.18)); }
  .chain__item::after {
    background: linear-gradient(180deg, var(--c0), var(--c1));
    transform-origin: center top; transform: scaleY(var(--seg)); transition: transform 0.16s linear;
  }
  /* Punkt auf der Linie: Kontur für kommende, gefüllt für erreichte Schritte,
     der aktive mit hellem Kern und Ring in der Achsenfarbe. */
  .chain__dot {
    position: relative; z-index: 1; flex: none; box-sizing: border-box;
    width: var(--step-node); height: var(--step-node); border-radius: 50%;
    margin-inline: var(--dot-pad);
    background: var(--ink);
    border: 1.5px solid color-mix(in oklab, var(--c0) 55%, transparent);
    transition: transform 0.24s var(--ease-out), border-color 0.24s, background-color 0.24s, box-shadow 0.24s;
  }
  .chain__text { display: flex; align-items: baseline; gap: 10px; }
  .chain__idx { font-family: var(--font-display); font-weight: 300; font-size: 0.82rem; letter-spacing: 0.06em; color: var(--fg-on-ink-muted); font-variant-numeric: tabular-nums; }
  .chain__label {
    font-family: var(--font-display); font-weight: 500; letter-spacing: -0.01em; font-size: 1rem; line-height: 1.3; color: var(--fg-on-ink);
    transition: color 0.24s var(--ease-out), opacity 0.24s var(--ease-out);
  }

  /* Szene an: Pin, Füllung von oben nach unten, Readout rechts */
  .chain[data-scene="on"] .chain__track { height: 380vh; }
  .chain[data-scene="on"] .chain__stage {
    position: sticky; top: 0; height: 100svh; height: 100dvh; box-sizing: border-box;
    padding-top: calc(var(--nav-h) + 12px); padding-bottom: 24px;
    grid-template-rows: auto 1fr; grid-template-columns: 1fr; gap: 16px; align-content: start;
  }
  .chain[data-scene="on"] .chain__rail { align-self: center; }
  .chain[data-scene="on"] .chain__item[data-passed] .chain__dot { background: var(--c0); border-color: var(--c0); }
  .chain[data-scene="on"] .chain__item:not([data-active]):not([data-passed]) .chain__label { color: var(--fg-on-ink-muted); opacity: 0.8; }
  .chain[data-scene="on"] .chain__item[data-passed] .chain__label { opacity: 0.9; }
  .chain[data-scene="on"] .chain__item[data-active] .chain__dot {
    background: #ffffff; border-color: var(--c0);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--c0) 28%, transparent);
    transform: scale(1.1);
  }
  .chain[data-scene="on"] .chain__item[data-active] .chain__label { color: #ffffff; }
  .chain__step:hover .chain__label { color: var(--fg-on-ink); opacity: 1; }

  /* Readout: editorial statt Karte. Riesige Ziffer links, daneben Phase,
     Titel und Text; die Trennlinie oben nimmt die Achse auf. */
  .chain[data-scene="on"] .chain__readout {
    display: block;
    position: relative;
    align-self: center;
    min-height: 360px;
    max-width: 760px;
    width: 100%;
    font-family: var(--font-display);
    letter-spacing: -0.02em;
  }
  /* Karte: Glas mit klarer Kontur. Transluzent mit Blur, 1px Rand, Radius,
     weicher Schatten; die vordere Karte (is-front) hat einen helleren Rand. */
  @media (max-width: 899px) {
    .chain__card { -webkit-backdrop-filter: none; backdrop-filter: none; background: var(--ink-2); }
  }
  .chain__card {
    position: absolute;
    inset: 0 0 auto 0;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    column-gap: clamp(24px, 3vw, 44px);
    row-gap: 6px;
    align-content: start;
    align-items: start;
    padding: 36px 36px 36px;
    border-radius: 22px;
    border: 1px solid rgba(245, 241, 251, 0.14);
    background: linear-gradient(160deg, rgba(245, 241, 251, 0.07), rgba(245, 241, 251, 0.03));
    -webkit-backdrop-filter: blur(16px) saturate(1.2);
    backdrop-filter: blur(16px) saturate(1.2);
    box-shadow:
      0 24px 60px rgba(8, 0, 22, 0.45),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
    will-change: transform, opacity, filter;
    transform-style: preserve-3d;
    backface-visibility: hidden;
    visibility: hidden;
    opacity: 0;
    transition: border-color 0.25s, box-shadow 0.25s;
  }
  /* Monotones Visual oben rechts (Higgsfield, Lavendel-Linien auf Schwarz,
     per Screen-Blend wird Schwarz unsichtbar). */
  .chain__card-art {
    grid-column: 3;
    grid-row: 1 / 6;
    align-self: start;
    justify-self: end;
    width: clamp(96px, 12vw, 150px);
    height: auto;
    margin: -8px -8px 0 0;
    opacity: 0;
    transition: opacity 0.35s var(--ease-out);
    pointer-events: none;
  }
  /* Nur die vordere Karte zeigt ihr Visual; die Nachbarn bleiben ruhig. */
  .chain__card.is-front .chain__card-art { opacity: 0.9; }
  @media (max-width: 599px) { .chain__card-art { display: none; } }
  .chain__card-cta {
    grid-column: 2;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
    width: fit-content;
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    color: var(--accent-on-ink);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 0.2s, border-color 0.2s;
  }
  .chain__card-cta svg { width: 14px; height: 14px; transition: transform 0.2s var(--ease-out); }
  .chain__card-cta:hover { color: var(--fg-on-ink); border-color: var(--line-on-ink-strong); }
  .chain__card-cta:hover svg { transform: translateX(3px); }
  /* Lichtkante oben auf der vorderen Karte: läuft mit dem Fortschritt der Achse. */
  .chain__card::before {
    content: "";
    position: absolute;
    inset: 0 auto auto 0;
    height: 1px;
    width: 100%;
    border-radius: inherit;
