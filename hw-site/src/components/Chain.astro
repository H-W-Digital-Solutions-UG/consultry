---
import { chain } from "../data/content";
---

<div class="chain" role="list" aria-label="Delivery Chain: From Process to Production">
  {chain.map((step, i) => (
    <div class="chain__item" role="listitem" style={`--i:${i}; --n:${chain.length}`}>
      <span class="chain__dot" aria-hidden="true"></span>
      <span class="chain__label">{step}</span>
    </div>
  ))}
</div>

<style>
  .chain {
    position: relative;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(150px, 1fr);
    gap: 0;
    overflow-x: auto;
    padding-block: 26px 8px;
    scrollbar-width: thin;
    -webkit-overflow-scrolling: touch;
  }
  .chain::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 31px;
    height: 2px;
    background: var(--axis);
    opacity: 0.85;
  }
  .chain__item {
    position: relative;
    padding: 0 18px 0 0;
    scroll-snap-align: start;
  }
  .chain__dot {
    display: block;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: color-mix(in oklab, var(--process) calc(100% - var(--i) / (var(--n) - 1) * 100%), var(--production));
    box-shadow: 0 0 0 5px var(--ink);
  }
  .chain__label {
    display: block;
    margin-top: 16px;
    font-size: 0.86rem;
    line-height: 1.35;
    color: var(--fg-on-ink-muted);
    text-wrap: balance;
  }
</style>
