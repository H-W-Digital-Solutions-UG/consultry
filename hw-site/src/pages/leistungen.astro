---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import Steps from "../components/Steps.astro";
import Capabilities from "../components/Capabilities.astro";
import Cta from "../components/Cta.astro";
import { positioning } from "../data/content";
---

<Base
  title="Wir bauen, was wir empfehlen"
  description="Leistungen von H&W Digital Solutions: Prozessanalyse, Bewertung von AI-Potenzialen, AI-natives Prozessdesign, eigenes Engineering und produktiver Betrieb."
>
  <PageHeader
    eyebrow={positioning.category}
    title="Wir bauen, was wir empfehlen."
    lede="Prozessanalyse, Lösungsdesign und Engineering aus einem Team. Verantwortung bis in den Betrieb."
  />

  <section class="section">
    <div class="container">
      <p class="eyebrow" data-n="01">Das Leistungsbild</p>
      <h2 class="h">Zehn Schritte. Alle in unserer Verantwortung.</h2>
      <div class="body"><Steps /></div>
    </div>
  </section>

  <section class="section section--paper-2">
    <div class="container">
      <p class="eyebrow" data-n="02">Capabilities</p>
      <h2 class="h">Ohne diese Fähigkeiten bliebe es bei der Empfehlung.</h2>
      <div class="body"><Capabilities /></div>
    </div>
  </section>

  <Cta heading="Welcher Prozess soll zuerst dran?" text="Ein Ablauf, der Zeit oder Nerven kostet, reicht als Einstieg." />
</Base>

<style>
  .h { margin-top: 16px; max-width: 20ch; }
  .h + .lede { margin-top: 16px; }
  .body { margin-top: 44px; }
</style>
