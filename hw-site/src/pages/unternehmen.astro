---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import Cta from "../components/Cta.astro";
import { company } from "../data/company";
import { positioning } from "../data/content";
---

<Base
  title="Unternehmen"
  description="H&W Digital Solutions ist ein AI-nativer Consulting-, Transformation- und Engineering-Partner aus Berlin. Wir analysieren Geschäftsprozesse und bauen die AI-Lösungen dazu selbst."
>
  <PageHeader
    eyebrow="Unternehmen"
    title="AI-nativ. Beratend und bauend."
    lede={positioning.principle}
  />

  <section class="section">
    <div class="container grid">
      <div>
        <p class="eyebrow">Wer wir sind</p>
        <h2 class="h">Ein Partner für Transformation und Engineering.</h2>
      </div>
      <div class="prose">
        <p>
          {company.name} ist ein Consulting-, Transformation- und Engineering-Partner mit Sitz in Berlin.
          Wir positionieren uns bewusst nicht als reine AI-Beratung: Unser Leistungsbild beginnt im
          Unternehmen und in seinen tatsächlichen Geschäftsprozessen – und es endet erst, wenn die
          daraus entwickelte Lösung produktiv läuft.
        </p>
        <p>
          Dafür verbinden wir Business Process Analysis, AI-Strategie und Prozess-Redesign mit AI-,
          Software- und Model-Engineering, Cloud-Infrastruktur, Cybersecurity, AI-Governance und
          Enablement. Sicherheit und Governance sind dabei kein nachgelagerter Schritt, sondern Teil
          jeder Lösung, die wir bauen.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--paper-2">
    <div class="container grid">
      <div>
        <p class="eyebrow">Geschäftsführung</p>
        <h2 class="h">Zwei Gründer, ein Anspruch.</h2>
      </div>
      <ul class="people">
        {company.managingDirectors.map((name) => (
          <li class="person">
            <span class="person__mark" aria-hidden="true"></span>
            <span class="person__name">{name}</span>
            <span class="person__role">Geschäftsführer</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Cta heading="Lernen wir uns kennen." text="Ein erstes Gespräch ist unverbindlich – und meistens schon konkret." />
</Base>

<style>
  .grid { display: grid; gap: 32px; }
  @media (min-width: 900px) { .grid { grid-template-columns: 1fr 1.3fr; gap: 64px; } }
  .h { margin-top: 16px; max-width: 16ch; }
  .prose { color: var(--fg-muted); font-size: 1.05rem; }
  .people { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; align-content: start; }
  .person {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 16px;
    padding: 20px 22px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .person__mark { width: 14px; height: 14px; border-radius: 4px; background: var(--axis); }
  .person__name { font-family: var(--font-display); font-weight: 600; letter-spacing: -0.02em; }
  .person__role { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--fg-muted); }
</style>
