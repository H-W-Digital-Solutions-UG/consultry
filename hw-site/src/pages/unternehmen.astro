---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import Cta from "../components/Cta.astro";
import SectionCta from "../components/SectionCta.astro";
import { company } from "../data/company";
---

<Base
  title="Berater, die selbst bauen"
  description="H&W Digital Solutions aus Berlin: AI Transformation & Engineering. Wir analysieren Geschäftsprozesse, finden die größten AI-Hebel und bauen die Lösung selbst."
>
  <PageHeader
    eyebrow="Über H&W"
    title="Berater, die selbst bauen."
    lede={`AI Transformation & Engineering aus Berlin. Gegründet und geführt von ${company.managingDirectors.join(" und ")}.`}
  />

  <section class="section">
    <div class="container grid">
      <div>
        <p class="eyebrow" data-n="01">Wer wir sind</p>
        <h2 class="h">Keine reine Beratung. Keine reine Agentur.</h2>
      </div>
      <div class="prose">
        <p>
          {company.name} verbindet Prozessanalyse mit eigenem Engineering. Wir beginnen bei den
          Abläufen in Ihrem Unternehmen und sind erst fertig, wenn die Lösung produktiv läuft.
        </p>
        <p>
          Wir kommen aus Cybersecurity und Software Engineering. Deshalb bauen wir Absicherung,
          Governance und Compliance in jede Lösung ein, statt sie am Ende zu prüfen.
        </p>
      </div>
    </div>
    <div class="container">
      <SectionCta line="Lernen Sie die kennen, die später bauen." secondary={{ label: "So arbeiten wir", href: "/vorgehen" }} />
    </div>
  </section>

  <section class="section section--paper-2">
    <div class="container grid">
      <div>
        <p class="eyebrow" data-n="02">Geschäftsführung</p>
        <h2 class="h">Zwei Gründer. Eine Verantwortung.</h2>
        <p class="team__senior">Keine Junior-Berater. Sie arbeiten mit denen, die Sie kennenlernen.</p>
      </div>
      <ul class="people">
        {company.managingDirectors.map((name) => (
          <li class="person">
            <span class="person__mark" aria-hidden="true"></span>
            <span class="person__name">{name}</span>
            <span class="person__role">Geschäftsführer</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Cta heading="Reden wir über Ihren Prozess." text="30 Minuten, ein konkreter Ablauf. Mehr braucht es für den Anfang nicht." />
</Base>

<style>
  .grid { display: grid; gap: 32px; }
  @media (min-width: 900px) { .grid { grid-template-columns: 1fr 1.3fr; gap: 64px; } }
  .h { margin-top: 16px; max-width: 16ch; }
  .team__senior { margin-top: 16px; color: var(--fg-muted); max-width: 34ch; }
  .prose { color: var(--fg-muted); font-size: 1.05rem; }
  .people { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; align-content: start; }
  .person {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 16px;
    padding: 20px 22px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }
  .person__mark { width: 14px; height: 14px; border-radius: 4px; background: var(--axis); }
  .person__name { font-family: var(--font-display); font-weight: 600; letter-spacing: -0.02em; }
  .person__role { font-size: 0.85rem; font-weight: 500; color: var(--fg-muted); }
</style>
