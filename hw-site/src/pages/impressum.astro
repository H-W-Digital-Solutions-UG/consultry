---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import { company } from "../data/company";
---

<Base title="Impressum" description={`Impressum der ${company.legalName}.`}>
  <PageHeader eyebrow="Rechtliches" title="Impressum" />

  <section class="section">
    <div class="container legal">
      <h2>Angaben gemäß § 5 DDG</h2>
      <p>
        {company.legalName}<br />
        {company.address.street}<br />
        {company.address.postalCode} {company.address.city}<br />
        {company.address.country}
      </p>

      <h2>Vertreten durch</h2>
      <p>Geschäftsführer: {company.managingDirectors.join(", ")}</p>

      <h2>Kontakt</h2>
      <p>
        Telefon: <a href={company.phoneHref}>{company.phoneDisplay}</a><br />
        E-Mail: <a href={`mailto:${company.email}`}>{company.email}</a>
      </p>

      <h2>Registereintrag</h2>
      <p>
        Eintragung im Handelsregister.<br />
        Registergericht: {company.registerCourt}<br />
        Registernummer: {company.commercialRegister}
      </p>

      <h2>Umsatzsteuer-ID</h2>
      <p>Umsatzsteuer-Identifikationsnummer gemäß § 27a Umsatzsteuergesetz: {company.vatId}</p>

      <h2>Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV</h2>
      <p>{company.managingDirectors.join(", ")}, Anschrift wie oben.</p>

      <h2>EU-Streitschlichtung</h2>
      <p>
        Die Europäische Kommission stellt eine Plattform zur Online-Streitbeilegung (OS) bereit:
        <a href={company.euDisputeUrl} rel="noopener" target="_blank">{company.euDisputeUrl}</a>.
        Unsere E-Mail-Adresse finden Sie oben im Impressum.
      </p>

      <h2>Verbraucherstreitbeilegung</h2>
      <p>
        Wir sind nicht bereit oder verpflichtet, an Streitbeilegungsverfahren vor einer
        Verbraucherschlichtungsstelle teilzunehmen.
      </p>
    </div>
  </section>
</Base>

<style is:global>
  .legal { max-width: 70ch; }
  .legal h2 { font-size: 1.15rem; margin-top: 32px; }
  .legal h2:first-child { margin-top: 0; }
  .legal p { margin-top: 10px; color: var(--fg-muted); line-height: 1.7; }
  .legal a { color: var(--fg); text-decoration: underline; text-underline-offset: 3px; }
</style>
