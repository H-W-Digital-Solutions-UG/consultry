---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Chain from "../components/Chain.astro";
import Contrast from "../components/Contrast.astro";
import Capabilities from "../components/Capabilities.astro";
import Cta from "../components/Cta.astro";
import SectionCta from "../components/SectionCta.astro";
import Proof from "../components/Proof.astro";
import { promise, sovereignty, software, showcases } from "../data/content";
import { company } from "../data/company";
---

<Base
  bareTitle
  title={`${company.name} – ${company.tagline}`}
  description="H&W Digital Solutions, Berlin: Wir finden die größten AI-Hebel in Ihren Geschäftsprozessen und bauen die Lösung selbst, bis sie produktiv läuft."
>
  <Hero imageAlt="">
    <Proof slot="after" variant="strip" />
  </Hero>

  <section class="section promise" id="versprechen">
    <div class="container">
      <div class="promise__head">
        <div>
          <p class="eyebrow" data-n="01">Unser Versprechen</p>
          <h2>{promise.short}</h2>
        </div>
        <p class="lede promise__lede">{promise.lede}</p>
      </div>
      <ol class="promise__rows">
        {promise.objections.map((o, i) => (
          <li class="promise__row">
            <span class="promise__n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <div class="promise__left">
              <p class="promise__quote"><span>„{o.quote}“</span></p>
              <div class="promise__data">
                <div class="promise__data-chart" aria-hidden="true">
                  {o.data.chart === "ring" && (
                    <svg class="ring" viewBox="0 0 40 40" width="40" height="40">
                      <circle class="ring__track" cx="20" cy="20" r="16" />
                      <circle class="ring__fill" cx="20" cy="20" r="16" style={`--c: 100.53; --v: ${o.data.series[0].v}`} />
                    </svg>
                  )}
                  {o.data.chart === "dots" && (
                    <span class="dots">{Array.from({ length: o.data.series[0].v }).map((_, k) => <i style={`--k: ${k}`}></i>)}</span>
                  )}
                  {o.data.chart === "bars" && (
                    <span class="bars">{o.data.series.map((sg) => <span class="bars__track"><span class="bars__fill" style={`--w: ${sg.v}%`}></span></span>)}</span>
                  )}
                  {o.data.chart === "stack" && (
                    <span class="stack">{o.data.series.map((sg) => <span class="stack__seg" style={`--w: ${sg.v}%`}></span>)}</span>
                  )}
                </div>
                <p class="promise__data-text">
                  <span class="promise__data-value"><span class="num" data-to={o.data.value}>{o.data.value}</span>{o.data.unit && <span class="promise__data-unit">{o.data.unit}</span>}</span>
                  {" "}{o.data.label}.
                </p>
                <p class="promise__data-source">{o.data.source}</p>
              </div>
            </div>
            <div class="promise__answer">
              <h3 class="promise__hook">{o.hook}</h3>
              <p class="promise__text">{o.text}</p>
              <a class="promise__cta" href={o.cta.href}>
                {o.cta.label}
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
              </a>
            </div>
          </li>
        ))}
      </ol>
      <SectionCta line={promise.cta.line} secondary={promise.cta.secondary} />
    </div>
  </section>

  <section class="section section--paper-2 sov">
    <div class="container">
      <div class="sov__grid">
        <div>
          <p class="eyebrow" data-n="02">{sovereignty.eyebrow}</p>
          <h2 class="sec__h">{sovereignty.heading}</h2>
        </div>
        <p class="lede sov__lede">{sovereignty.text}</p>
      </div>
      <ol class="sov__points">
        {sovereignty.points.map((pt, i) => (
          <li class:list={["sov__point", { "sov__point--win": i === sovereignty.points.length - 1 }]}>
            <span class="sov__n">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="sov__title">{pt.title}</h3>
            <p class="sov__text">{pt.text}</p>
          </li>
        ))}
      </ol>
      <ul class="sov__cases">
        {showcases.map((c) => (
          <li>
            <a class="case" href={c.href}>
              <span class="case__kicker">{c.kicker}</span>
              <span class="case__title">{c.title}</span>
              <span class="case__text">{c.text}</span>
              <span class="case__link">Showcase ansehen<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg></span>
            </a>
          </li>
        ))}
      </ul>
      <SectionCta line="Welcher Ablauf hängt bei Ihnen an zu vielen Anbietern?" />
    </div>
  </section>

  <section class="section section--ink chainsec">
    <div class="container">
      <Chain>
        <Fragment slot="heading">
          <p class="eyebrow" data-n="03">From Process to Production</p>
          <h2 class="chainsec__h">Zwölf Schritte, ein Team, keine Übergabe.</h2>
        </Fragment>
      </Chain>
      <SectionCta line="Wo fängt Schritt eins bei Ihnen an?" secondary={{ label: "Vorgehen im Detail", href: "/vorgehen" }} />
    </div>
  </section>

  <section class="section section--paper-2 seven">
    <div class="container seven__grid">
      <div>
        <p class="eyebrow" data-n="04">Das Leistungsbild</p>
        <h2 class="sec__h">Technologie kommt bei uns erst an Schritt sieben.</h2>
      </div>
      <div class="seven__side">
        <p class="lede">Vorher bewerten wir jedes Potenzial nach wirtschaftlichem Hebel und technischer Machbarkeit. Gebaut wird, was sich rechnet. Gemessen wird, was läuft.</p>
        <a class="btn btn--ghost" href="/leistungen">Zehn Schritte im Detail</a>
      </div>
    </div>
  </section>

  <section class="section section--ink">
    <div class="container">
      <p class="eyebrow" data-n="05">Der Unterschied</p>
      <h2 class="sec__h">Wo Beratung aufhört, fangen wir an.</h2>
      <div class="sec__body"><Contrast /></div>
      <SectionCta line="Lieber ein Ergebnis als eine Roadmap?" />
    </div>
  </section>

  <section class="section soft">
    <div class="container soft__grid">
      <div>
        <p class="eyebrow" data-n="06">{software.eyebrow}</p>
        <h2 class="sec__h">{software.heading}</h2>
      </div>
      <div class="soft__side">
        <p class="lede">{software.lede}</p>
        <ul class="soft__offers">
          {software.offers.map((o) => <li>{o.title}</li>)}
        </ul>
        <div class="soft__actions">
          <a class="btn btn--primary" href={software.cta.primary.href}>{software.cta.primary.label}<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg></a>
          <a class="btn btn--ghost" href="/leistungen#software">Software und Web im Detail</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--paper-2">
    <div class="container">
      <p class="eyebrow" data-n="07">Womit wir bauen</p>
      <h2 class="sec__h">Ein Modell ist noch keine Lösung.</h2>
      <div class="sec__body"><Capabilities /></div>
      <SectionCta line="Was davon Ihr Ablauf braucht, klären wir im Gespräch." secondary={{ label: "Leistungen im Detail", href: "/leistungen" }} />
    </div>
  </section>

  <Cta />
</Base>

<script>
  const list = document.querySelector<HTMLElement>(".promise__rows");
  const rows = Array.from(document.querySelectorAll<HTMLElement>(".promise__row"));
  const ok =
    list &&
    "IntersectionObserver" in window &&
    !window.matchMedia("(prefers-reduced-motion: reduce)").matches &&
    window.matchMedia("(min-width: 900px)").matches;
  const ease = (t: number) => 1 - Math.pow(1 - t, 3);
  const count = (el: HTMLElement) => {
    const to = Number(el.dataset.to || 0);
    const t0 = performance.now();
    const step = (now: number) => {
      const t = Math.min(1, (now - t0) / 1000);
      el.textContent = String(Math.round(to * ease(t)));
      if (t < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };
  if (ok) {
    list.dataset.anim = "";
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          e.target.classList.add("is-in");
          e.target.querySelectorAll<HTMLElement>(".num").forEach(count);
          io.unobserve(e.target);
        });
      },
      { rootMargin: "0px 0px -12% 0px" },
    );
    rows.forEach((r) => io.observe(r));
  }
</script>

<style>
  .promise__head { display: grid; gap: 24px; }
  @media (min-width: 900px) { .promise__head { grid-template-columns: 1.1fr 1fr; gap: 64px; align-items: end; } }
  .promise h2 { margin-top: 16px; max-width: 16ch; }
  .promise__lede { margin: 0; }
  /* Einwand-Zeilen: Ziffer, Einwand groß in Kundensprache, Antwort daneben.
     Beim Scrollen wird der Einwand durchgestrichen und die Antwort erscheint. */
  .promise__rows { list-style: none; margin: 40px 0 0; padding: 0; border-top: 1px solid var(--line); }
  .promise__row {
    display: grid; gap: 10px 24px;
    padding-block: 26px;
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 900px) {
    .promise__row { grid-template-columns: 48px minmax(0, 1fr) minmax(0, 1fr); gap: 48px; padding-block: 34px; align-items: start; }
  }
  .promise__n { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.14em; color: var(--accent); padding-top: 0.6em; }
  .promise__quote {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.3vw, 2rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--fg-muted);
    text-wrap: balance;
    max-width: 18ch;
  }
  .promise__quote span {
    text-decoration: line-through;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--accent);
    text-decoration-skip-ink: none;
  }
  .promise__answer { display: grid; gap: 8px; justify-items: start; }
  .promise__hook { font-size: clamp(1.15rem, 1.6vw, 1.4rem); letter-spacing: -0.015em; max-width: 24ch; text-wrap: balance; }
  .promise__text { margin: 0; color: var(--fg-muted); max-width: 44ch; }
  .promise__cta {
    display: inline-flex; align-items: center; gap: 8px;
    margin-top: 6px;
    font-family: var(--font-display); font-size: 0.9rem; font-weight: 600; letter-spacing: -0.005em;
    color: var(--accent); text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 0.2s, border-color 0.2s;
  }
  .promise__cta svg { width: 14px; height: 14px; transition: transform 0.2s var(--ease-out); }
  .promise__cta:hover, .promise__cta:focus-visible { color: var(--fg); border-color: var(--line-strong); }
  .promise__cta:hover svg { transform: translateX(3px); }
  /* Datenpunkt unter dem Einwand: Mini-Chart, Wert im Satz, Quelle. */
  .promise__left { display: grid; gap: 18px; align-content: start; }
  .promise__data { display: grid; gap: 8px; max-width: 34ch; }
  .promise__data-chart { display: flex; align-items: center; height: 40px; }
  .promise__data-text { margin: 0; font-size: 0.9rem; line-height: 1.5; color: var(--fg-muted); }
  .promise__data-value { font-family: var(--font-display); font-weight: 700; font-size: 1.5rem; letter-spacing: -0.03em; color: var(--fg); font-variant-numeric: tabular-nums; margin-right: 2px; }
  .promise__data-unit { font-size: 0.62em; font-weight: 600; margin-left: 2px; color: var(--fg-muted); }
  .promise__data-source { margin: 0; font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.02em; color: var(--fg-muted); opacity: 0.8; }
  .ring { transform: rotate(-90deg); }
  .ring__track { fill: none; stroke: var(--line); stroke-width: 4; }
  .ring__fill { fill: none; stroke: var(--accent); stroke-width: 4; stroke-linecap: round; stroke-dasharray: var(--c); stroke-dashoffset: calc(var(--c) * (1 - var(--v) / 100)); }
  .dots { display: inline-flex; gap: 6px; }
  .dots i { width: 10px; height: 10px; border-radius: 50%; background: var(--accent); }
  .bars { display: grid; gap: 6px; width: 180px; }
  .bars__track { display: block; height: 4px; border-radius: 2px; background: var(--line); overflow: hidden; }
  .bars__fill { display: block; height: 100%; width: var(--w); border-radius: 2px; background: var(--accent); }
  .bars__track + .bars__track .bars__fill { opacity: 0.45; }
  .stack { display: flex; gap: 2px; width: 180px; height: 6px; border-radius: 3px; overflow: hidden; background: var(--line); }
  .stack__seg { display: block; height: 100%; width: var(--w); background: var(--accent); }
  .stack__seg + .stack__seg { opacity: 0.35; }
  @media (max-width: 899px) {
    /* Mobil: Einwand, Antwort, dann der Zahlenpunkt als Beleg. */
    .promise__left { display: contents; }
    .promise__quote { order: 1; }
    .promise__answer { order: 2; }
    .promise__data { order: 3; margin-top: 6px; padding-top: 12px; border-top: 1px dashed var(--line); }
    .promise__data-chart { height: 32px; }
    .ring { width: 32px; height: 32px; }
  }

  /* Animation nur, wenn das Skript sie freigibt (Desktop, keine Reduced Motion). */
  .promise__rows[data-anim] .promise__quote span { text-decoration-color: transparent; transition: text-decoration-color 0.55s var(--ease-out) 0.1s; }
  .promise__rows[data-anim] .promise__row.is-in .promise__quote span { text-decoration-color: var(--accent); }
  .promise__rows[data-anim] .promise__answer { opacity: 0; transform: translateY(10px); transition: opacity 0.6s var(--ease-out) 0.4s, transform 0.6s var(--ease-out) 0.4s; }
  .promise__rows[data-anim] .promise__row.is-in .promise__answer { opacity: 1; transform: none; }
  .promise__rows[data-anim] .promise__data { opacity: 0; transition: opacity 0.6s var(--ease-out) 0.25s; }
  .promise__rows[data-anim] .promise__row.is-in .promise__data { opacity: 1; }
  .promise__rows[data-anim] :is(.bars__fill, .stack__seg) { width: 0; transition: width 1s var(--ease-out) 0.3s; }
  .promise__rows[data-anim] .promise__row.is-in .bars__fill { width: var(--w); }
  .promise__rows[data-anim] .promise__row.is-in .stack__seg { width: var(--w); }
  .promise__rows[data-anim] .ring__fill { stroke-dashoffset: var(--c); transition: stroke-dashoffset 1s var(--ease-out) 0.3s; }
  .promise__rows[data-anim] .promise__row.is-in .ring__fill { stroke-dashoffset: calc(var(--c) * (1 - var(--v) / 100)); }
  .promise__rows[data-anim] .dots i { transform: scale(0); transition: transform 0.3s var(--ease-out); }
  .promise__rows[data-anim] .promise__row.is-in .dots i { transform: none; }
  .promise__rows[data-anim] .promise__row.is-in .dots i { transition-delay: calc(0.3s + var(--k, 0) * 0.05s); }
  .promise__row:hover .promise__quote { color: var(--fg); }
  .promise__quote { transition: color 0.2s; }
  .chainsec__h, .sec__h { margin-top: 16px; max-width: 20ch; }
  .chainsec__h { max-width: 22ch; }
  .chainsec { padding-block: 0 72px; }
  .sec__h + .lede { margin-top: 16px; }
  .sec__body { margin-top: 44px; }
  .sov__grid { display: grid; gap: 24px; }
  @media (min-width: 900px) { .sov__grid { grid-template-columns: 1.1fr 1fr; gap: 64px; align-items: end; } }
  .sov__lede { margin: 0; }
  .sov__points {
    list-style: none; margin: 44px 0 0; padding: 0;
    display: grid; gap: 1px;
    background: var(--line); border: 1px solid var(--line); border-radius: var(--radius-lg); overflow: hidden;
  }
  @media (min-width: 720px) { .sov__points { grid-template-columns: repeat(3, 1fr); } }
  .sov__point { background: var(--paper); padding: 26px 24px 28px; display: grid; gap: 10px; align-content: start; }
  .sov__n { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.14em; color: var(--accent); }
  .sov__title { font-size: 1.2rem; }
  .sov__text { color: var(--fg-muted); font-size: 0.98rem; }
  /* Showcases: zwei verlinkte Karten unter den Punkten */
  .sov__cases { list-style: none; margin: 24px 0 0; padding: 0; display: grid; gap: 14px; }
  @media (min-width: 720px) { .sov__cases { grid-template-columns: repeat(2, 1fr); } }
  .case {
    display: grid; gap: 8px; align-content: start; height: 100%;
    padding: 24px 24px 22px;
    background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius-lg);
    text-decoration: none; color: inherit;
    transition: border-color 0.2s, transform 0.25s var(--ease-out);
  }
  .case:hover { border-color: var(--line-strong); transform: translateY(-2px); }
  .case__kicker { font-family: var(--font-display); font-size: 0.85rem; font-weight: 500; color: var(--accent); }
  .case__title { font-family: var(--font-display); font-size: 1.25rem; font-weight: 600; letter-spacing: -0.015em; line-height: 1.25; }
  .case__text { color: var(--fg-muted); font-size: 0.95rem; }
  .case__link { display: inline-flex; align-items: center; gap: 8px; margin-top: 6px; font-family: var(--font-display); font-size: 0.9rem; font-weight: 600; color: var(--accent); }
  .case__link svg { width: 14px; height: 14px; transition: transform 0.2s var(--ease-out); }
  .case:hover .case__link svg { transform: translateX(3px); }
  .sov__point--win { background: var(--ink); }
  .sov__point--win .sov__n { color: var(--accent-on-ink); }
  .sov__point--win .sov__title { color: var(--fg-on-ink); }
  .sov__point--win .sov__text { color: var(--fg-on-ink-muted); }
  .soft__grid { display: grid; gap: 28px; }
  @media (min-width: 900px) { .soft__grid { grid-template-columns: 1.1fr 1fr; gap: 64px; align-items: start; } }
  .soft__side { display: grid; gap: 24px; justify-items: start; }
  .soft__side .lede { margin: 0; }
  .soft__offers { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .soft__offers li { padding: 6px 12px; border: 1px solid var(--line); border-radius: var(--radius-pill); font-family: var(--font-display); font-size: 0.88rem; font-weight: 500; }
  .soft__actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .seven__grid { display: grid; gap: 28px; }
  @media (min-width: 900px) { .seven__grid { grid-template-columns: 1.1fr 1fr; gap: 64px; align-items: end; } }
  .seven__side { display: grid; gap: 24px; justify-items: start; }
  .seven__side .lede { margin: 0; }
</style>
