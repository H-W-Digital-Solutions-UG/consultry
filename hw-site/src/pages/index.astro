---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Chain from "../components/Chain.astro";
import Contrast from "../components/Contrast.astro";
import Capabilities from "../components/Capabilities.astro";
import Cta from "../components/Cta.astro";
import SectionCta from "../components/SectionCta.astro";
import Proof from "../components/Proof.astro";
import { promise, sovereignty } from "../data/content";
import { company } from "../data/company";
---

<Base
  bareTitle
  title={`${company.name} – ${company.tagline}`}
  description="H&W Digital Solutions, Berlin: Wir finden die größten AI-Hebel in Ihren Geschäftsprozessen und bauen die Lösung selbst, bis sie produktiv läuft."
>
  <Hero imageAlt="">
    <Proof slot="after" variant="strip" />
  </Hero>

  <section class="section promise">
    <div class="container">
      <div class="promise__head">
        <div>
          <p class="eyebrow" data-n="01">Unser Versprechen</p>
          <h2>{promise.short}</h2>
        </div>
        <p class="lede promise__lede">{promise.lede}</p>
      </div>
      <ul class="promise__list">
        {promise.objections.map((o) => (
          <li class="promise__item">
            <p class="promise__quote">„{o.quote}“</p>
            <h3 class="promise__hook">{o.hook}</h3>
            <p class="promise__text">{o.text}</p>
            <a class="promise__cta" href={o.cta.href}>
              {o.cta.label}
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
            </a>
          </li>
        ))}
      </ul>
      <p class="promise__senior">{promise.senior}</p>
      <SectionCta line={promise.cta.line} secondary={promise.cta.secondary} />
    </div>
  </section>

  <section class="section section--ink chainsec">
    <div class="container">
      <Chain>
        <Fragment slot="heading">
          <p class="eyebrow" data-n="02">From Process to Production</p>
          <h2 class="chainsec__h">Schluss mit einem Dienstleister pro Schritt.</h2>
        </Fragment>
      </Chain>
      <SectionCta line="Wo fängt Schritt eins bei Ihnen an?" secondary={{ label: "Vorgehen im Detail", href: "/vorgehen" }} />
    </div>
  </section>

  <section class="section section--paper-2 seven">
    <div class="container seven__grid">
      <div>
        <p class="eyebrow" data-n="03">Das Leistungsbild</p>
        <h2 class="sec__h">Technologie kommt bei uns erst an Schritt sieben.</h2>
      </div>
      <div class="seven__side">
        <p class="lede">Vorher bewerten wir jedes Potenzial nach wirtschaftlichem Hebel und technischer Machbarkeit. Gebaut wird, was sich rechnet. Gemessen wird, was läuft.</p>
        <a class="btn btn--ghost" href="/leistungen">Zehn Schritte im Detail</a>
      </div>
    </div>
  </section>

  <section class="section section--ink">
    <div class="container">
      <p class="eyebrow" data-n="04">Der Unterschied</p>
      <h2 class="sec__h">Wo Beratung aufhört, fangen wir an.</h2>
      <div class="sec__body"><Contrast /></div>
      <SectionCta line="Lieber ein Ergebnis als eine Roadmap?" />
    </div>
  </section>

  <section class="section sov">
    <div class="container">
      <div class="sov__grid">
        <div>
          <p class="eyebrow" data-n="05">{sovereignty.eyebrow}</p>
          <h2 class="sec__h">{sovereignty.heading}</h2>
        </div>
        <p class="lede sov__lede">{sovereignty.text}</p>
      </div>
      <ol class="sov__points">
        {sovereignty.points.map((pt, i) => (
          <li class="sov__point">
            <span class="sov__n">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="sov__title">{pt.title}</h3>
            <p class="sov__text">{pt.text}</p>
          </li>
        ))}
      </ol>
      <SectionCta line="Ein Prozess genügt für den Anfang." />
    </div>
  </section>

  <section class="section section--paper-2">
    <div class="container">
      <p class="eyebrow" data-n="06">Womit wir bauen</p>
      <h2 class="sec__h">Ein Modell ist noch keine Lösung.</h2>
      <div class="sec__body"><Capabilities /></div>
      <SectionCta line="Was davon Ihr Ablauf braucht, klären wir im Gespräch." secondary={{ label: "Leistungen im Detail", href: "/leistungen" }} />
    </div>
  </section>

  <Cta />
</Base>

<style>
  .promise__head { display: grid; gap: 24px; }
  @media (min-width: 900px) { .promise__head { grid-template-columns: 1.1fr 1fr; gap: 64px; align-items: end; } }
  .promise h2 { margin-top: 16px; max-width: 16ch; }
  .promise__lede { margin: 0; }
  /* Vier Einwände als Zellenraster (gleiches Muster wie die Souveränitäts-Punkte). */
  .promise__list {
    list-style: none; margin: 44px 0 0; padding: 0;
    display: grid; gap: 1px;
    background: var(--line); border: 1px solid var(--line); border-radius: var(--radius-lg); overflow: hidden;
  }
  @media (min-width: 720px) { .promise__list { grid-template-columns: repeat(2, 1fr); } }
  .promise__item {
    background: var(--paper); padding: 28px 26px 30px;
    display: grid; gap: 12px; align-content: start;
    transition: background-color 0.2s;
  }
  .promise__item:hover { background: var(--paper-2); }
  .promise__quote { margin: 0; font-family: var(--font-display); font-size: 0.9rem; font-weight: 500; color: var(--accent); }
  .promise__hook { font-size: 1.35rem; letter-spacing: -0.015em; max-width: 24ch; text-wrap: balance; }
  .promise__text { margin: 0; color: var(--fg-muted); font-size: 0.98rem; }
  .promise__cta {
    display: inline-flex; align-items: center; gap: 8px;
    margin-top: 6px; width: fit-content;
    font-family: var(--font-display); font-size: 0.9rem; font-weight: 600; letter-spacing: -0.005em;
    color: var(--accent); text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color 0.2s, border-color 0.2s;
  }
  .promise__cta svg { width: 14px; height: 14px; transition: transform 0.2s var(--ease-out); }
  .promise__cta:hover, .promise__cta:focus-visible { color: var(--fg); border-color: var(--line-strong); }
  .promise__cta:hover svg { transform: translateX(3px); }
  .promise__senior {
    margin: 40px 0 0;
    font-family: var(--font-display); font-weight: 600;
    font-size: clamp(1.15rem, 1.8vw, 1.45rem); letter-spacing: -0.015em; line-height: 1.35;
    max-width: 40ch; text-wrap: balance;
  }
  .chainsec__h, .sec__h { margin-top: 16px; max-width: 20ch; }
  .chainsec__h { max-width: 22ch; }
  .chainsec { padding-block: 0 72px; }
  .sec__h + .lede { margin-top: 16px; }
  .sec__body { margin-top: 44px; }
  .sov__grid { display: grid; gap: 24px; }
  @media (min-width: 900px) { .sov__grid { grid-template-columns: 1.1fr 1fr; gap: 64px; align-items: end; } }
  .sov__lede { margin: 0; }
  .sov__points {
    list-style: none; margin: 44px 0 0; padding: 0;
    display: grid; gap: 1px;
    background: var(--line); border: 1px solid var(--line); border-radius: var(--radius-lg); overflow: hidden;
  }
  @media (min-width: 720px) { .sov__points { grid-template-columns: repeat(3, 1fr); } }
  .sov__point { background: var(--paper); padding: 26px 24px 28px; display: grid; gap: 10px; align-content: start; }
  .sov__n { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.14em; color: var(--accent); }
  .sov__title { font-size: 1.2rem; }
  .sov__text { color: var(--fg-muted); font-size: 0.98rem; }
  .seven__grid { display: grid; gap: 28px; }
  @media (min-width: 900px) { .seven__grid { grid-template-columns: 1.1fr 1fr; gap: 64px; align-items: end; } }
  .seven__side { display: grid; gap: 24px; justify-items: start; }
  .seven__side .lede { margin: 0; }
</style>
