---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import { company } from "../data/company";
---

<Base
  title="Bringen Sie einen Prozess mit"
  description="Erstgespräch mit H&W Digital Solutions: 30 Minuten, ein konkreter Prozess, eine erste Einschätzung. Antwort in der Regel innerhalb eines Werktags."
>
  <PageHeader
    eyebrow="Ihr kostenloses Erstgespräch"
    title="Bringen Sie einen Prozess mit."
    lede="30 Minuten, kostenlos, ohne Folien. Bringen Sie einen Ablauf mit, bei dem Ihr Team heute Zeit verliert. Wir sagen Ihnen, ob AI dort etwas bringt. Wenn nicht, sagen wir das auch."
  />

  <section class="section">
    <div class="container grid">
      <div class="card">
        <p class="eyebrow">Direkt</p>
        <a class="big" href={`mailto:${company.email}?subject=${encodeURIComponent("Erstgespräch: AI-Potenziale in unseren Prozessen")}`}>{company.email}</a>
        <a class="big big--sub" href={company.phoneHref}>{company.phoneDisplay}</a>
        <p class="hint">Antwort in der Regel innerhalb eines Werktags.</p>
      </div>
      <div class="card card--muted">
        <p class="eyebrow">Adresse</p>
        <address>
          {company.legalName}<br />
          {company.address.street}<br />
          {company.address.postalCode} {company.address.city}<br />
          {company.address.country}
        </address>
        <p class="eyebrow eyebrow--gap">Das reicht als Vorbereitung</p>
        <ul>
          <li>Ein Prozess, der Zeit oder Nerven kostet</li>
          <li>Wer beteiligt ist und welche Systeme im Spiel sind</li>
          <li>Was „besser“ für Sie messbar bedeutet</li>
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .grid { display: grid; gap: 16px; }
  @media (min-width: 900px) { .grid { grid-template-columns: 1.2fr 1fr; } }
  .card {
    padding: 32px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    background: var(--paper);
  }
  .card--muted { background: var(--paper-2); }
  .card:not(.card--muted) { box-shadow: var(--shadow-sm); }
  .big {
    display: block;
    margin-top: 18px;
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.6vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    overflow-wrap: anywhere;
  }
  .big:hover { text-decoration: underline; text-underline-offset: 4px; }
  .big--sub { margin-top: 8px; font-size: clamp(1.1rem, 2vw, 1.4rem); color: var(--fg-muted); }
  .hint { margin-top: 20px; color: var(--fg-muted); font-size: 0.92rem; }
  address { font-style: normal; margin-top: 16px; line-height: 1.7; }
  .eyebrow--gap { margin-top: 28px; }
  ul { margin: 14px 0 0; padding-left: 18px; color: var(--fg-muted); display: grid; gap: 6px; }
</style>
