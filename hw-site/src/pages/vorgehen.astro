---
import Base from "../layouts/Base.astro";
import PageHeader from "../components/PageHeader.astro";
import Chain from "../components/Chain.astro";
import Contrast from "../components/Contrast.astro";
import Cta from "../components/Cta.astro";
import SectionCta from "../components/SectionCta.astro";
import { contrast } from "../data/content";

const phases = [
  {
    key: "Prozess",
    title: "Erst verstehen, dann bewerten.",
    text: "Wo entstehen Reibung, Wartezeit und Doppelarbeit? Daraus werden AI-Potenziale, priorisiert nach Hebel und Machbarkeit.",
  },
  {
    key: "Design",
    title: "Neu denken statt anschrauben.",
    text: "Wo es sich lohnt, gestalten wir den Prozess AI-native neu. Ergebnis: ein Umsetzungspfad mit Reihenfolge und Meilensteinen.",
  },
  {
    key: "Engineering",
    title: "Wir bauen selbst.",
    text: "Dasselbe Team, das den Prozess verstanden hat, entwickelt die Lösung: Modelle, Software, Integrationen, Infrastruktur.",
  },
  {
    key: "Produktion",
    title: "Betrieb ist Teil des Auftrags.",
    text: "Security, Governance und Compliance sind Teil der Lösung. Wir deployen, befähigen Ihre Mitarbeiter und messen die Wirkung.",
  },
];
---

<Base
  title="Fertig ist erst, was läuft"
  description="So arbeitet H&W Digital Solutions: von der Prozessanalyse über AI-natives Design und eigenes Engineering bis zum abgesicherten, produktiven Betrieb."
>
  <PageHeader
    eyebrow="From Process to Production"
    title="Fertig ist erst, was läuft."
    lede="Zwölf Glieder, vier Phasen, dasselbe Team von Anfang bis Ende."
  />

  <section class="section section--ink chain-sec">
    <div class="container">
      <Chain>
        <Fragment slot="heading">
          <p class="eyebrow" data-n="01">Delivery Chain</p>
          <h2 class="chain-sec__h">Zwölf Glieder, ein Team.</h2>
        </Fragment>
      </Chain>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow" data-n="02">Vier Phasen</p>
      <ol class="phases">
        {phases.map((p, i) => (
          <li class="phase">
            <div class="phase__meta">
              <span class="phase__n">{String(i + 1).padStart(2, "0")}</span>
              <span class="eyebrow">{p.key}</span>
            </div>
            <h2>{p.title}</h2>
            <p>{p.text}</p>
          </li>
        ))}
      </ol>
      <SectionCta line="Ein Ablauf genügt, um Phase eins zu starten." />
    </div>
  </section>

  <section class="section section--ink">
    <div class="container">
      <p class="eyebrow" data-n="03">Abgrenzung</p>
      <h2 class="h">{contrast.heading}</h2>
      <p class="lede">{contrast.text}</p>
      <div class="body"><Contrast /></div>
    </div>
  </section>

  <Cta />
</Base>

<style>
  .chain-sec { padding-block: 0 56px; }
  .chain-sec__h { margin-top: 16px; max-width: 20ch; }
  .phases { list-style: none; margin: 24px 0 0; padding: 0; display: grid; gap: 0; }
  .phase {
    display: grid;
    gap: 14px;
    padding: 40px 0;
    border-top: 1px solid var(--line);
  }
  @media (min-width: 900px) {
    .phase { grid-template-columns: 200px 1fr 1.4fr; gap: 40px; align-items: start; }
  }
  .phase:last-child { border-bottom: 1px solid var(--line); }
  .phase__meta { display: flex; align-items: baseline; gap: 14px; }
  .phase__n { font-family: var(--font-display); font-size: 1.6rem; font-weight: 600; letter-spacing: -0.03em; }
  .phase h2 { font-size: clamp(1.4rem, 2.4vw, 1.9rem); }
  .phase p { color: var(--fg-muted); max-width: 60ch; }
  .h { margin-top: 16px; max-width: 20ch; }
  .h + .lede { margin-top: 16px; }
  .body { margin-top: 44px; }
</style>
